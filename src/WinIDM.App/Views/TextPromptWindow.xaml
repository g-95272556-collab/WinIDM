<Window x:Class="WinIDM.App.Views.TextPromptWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="520" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" ResizeMode="NoResize">
    <StackPanel>
        <!-- ================= Page header ================= -->
        <Grid Margin="20,12,20,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid Width="36" Height="36" VerticalAlignment="Top">
                <Border CornerRadius="11" Background="{DynamicResource AccentSoftBrush}"
                        BorderBrush="{DynamicResource AccentSoftBorderBrush}" BorderThickness="1"/>
                <TextBlock Text="&#xE70F;" FontFamily="Segoe MDL2 Assets" FontSize="16"
                           Foreground="{DynamicResource AccentBrush}"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Grid>
            <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                <TextBlock Style="{StaticResource Heading}" TextWrapping="Wrap"
                           Text="{Binding Title, RelativeSource={RelativeSource AncestorType=Window}}"/>
                <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,2,0,0"
                           Text="Type the value below, then press OK."/>
            </StackPanel>
        </Grid>

        <!-- ================= Input ================= -->
        <Border Style="{StaticResource Card}" Margin="20,0,20,0" Padding="16">
            <StackPanel>
                <TextBlock x:Name="PromptLabel" TextWrapping="Wrap" FontWeight="SemiBold" Margin="0,0,0,8"/>
                <TextBox x:Name="Input"/>
            </StackPanel>
        </Border>

        <!-- ================= Footer ================= -->
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="20,12,20,16">
            <Button Content="OK" IsDefault="True" Style="{StaticResource PrimaryButton}"
                    MinWidth="96" Margin="0,0,8,0" Click="Ok_Click"/>
            <Button Content="Cancel" IsCancel="True" Style="{StaticResource SecondaryButton}"
                    MinWidth="96"/>
        </StackPanel>
    </StackPanel>
</Window>
