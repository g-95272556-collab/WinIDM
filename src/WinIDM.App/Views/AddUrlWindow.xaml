<Window x:Class="WinIDM.App.Views.AddUrlWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Add download"
        Width="580" SizeToContent="Height"
        ResizeMode="CanResizeWithGrip"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">
    <Window.Resources>
        <!-- Row label of the form grid: primary text, bottom margin = row gap. -->
        <Style x:Key="FormLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,16,12"/>
        </Style>
        <!-- Input of the form grid: keeps the row rhythm without a fixed height. -->
        <Style x:Key="FormInput" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>
    </Window.Resources>

    <StackPanel>
        <!-- ================= Page header ================= -->
        <Grid Margin="20,18,20,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid Width="40" Height="40" VerticalAlignment="Top">
                <Border CornerRadius="12" Background="{DynamicResource AccentSoftBrush}"
                        BorderBrush="{DynamicResource AccentSoftBorderBrush}" BorderThickness="1"/>
                <TextBlock Text="&#xE896;" FontFamily="Segoe MDL2 Assets" FontSize="18"
                           Foreground="{DynamicResource AccentBrush}"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Grid>
            <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                <TextBlock Text="Add download" Style="{StaticResource Heading}"/>
                <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,2,0,0"
                           Text="Paste a link and choose where the file is saved."/>
            </StackPanel>
        </Grid>

        <!-- ================= Source and destination ================= -->
        <!-- Bottom padding is 18 - 12 because the last input carries the row gap as its bottom margin. -->
        <Border Style="{StaticResource Card}" Margin="20,0,20,0" Padding="18,18,18,6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="150"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="URL" Style="{StaticResource FormLabel}"/>
                <TextBox x:Name="UrlBox" Grid.Row="0" Grid.Column="1"
                         Style="{StaticResource FormInput}"
                         Text="{Binding Url, UpdateSourceTrigger=PropertyChanged}"/>

                <TextBlock Grid.Row="1" Grid.Column="0" Text="File name" Style="{StaticResource FormLabel}"/>
                <TextBox Grid.Row="1" Grid.Column="1" Style="{StaticResource FormInput}"
                         Text="{Binding FileName, UpdateSourceTrigger=PropertyChanged}"/>

                <TextBlock Grid.Row="2" Grid.Column="0" Text="Folder" Style="{StaticResource FormLabel}"/>
                <Grid Grid.Row="2" Grid.Column="1" Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox Text="{Binding Folder, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,8,0"/>
                    <Button Grid.Column="1" Content="Choose..." VerticalAlignment="Center"
                            Padding="14,6" Click="Browse_Click"/>
                </Grid>

                <TextBlock Grid.Row="3" Grid.Column="0" Text="Number of segments" Style="{StaticResource FormLabel}"/>
                <TextBox Grid.Row="3" Grid.Column="1" Width="90" HorizontalAlignment="Left"
                         Style="{StaticResource FormInput}"
                         Text="{Binding Parts, UpdateSourceTrigger=PropertyChanged}" ToolTip="1 to 32"/>

                <TextBlock Grid.Row="4" Grid.Column="0" Text="Username (auth)" Style="{StaticResource FormLabel}"/>
                <TextBox Grid.Row="4" Grid.Column="1" Style="{StaticResource FormInput}"
                         Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}"/>

                <TextBlock Grid.Row="5" Grid.Column="0" Text="Password (auth)" Style="{StaticResource FormLabel}"/>
                <PasswordBox x:Name="PwdBox" Grid.Row="5" Grid.Column="1" Margin="0,0,0,12"/>

                <TextBlock Grid.Row="6" Grid.Column="0" Text="Referer" Style="{StaticResource FormLabel}"/>
                <TextBox Grid.Row="6" Grid.Column="1" Style="{StaticResource FormInput}"
                         Text="{Binding Referer, UpdateSourceTrigger=PropertyChanged}"/>
            </Grid>
        </Border>

        <!-- ================= Options ================= -->
        <Border Style="{StaticResource SoftCard}" Margin="20,12,20,0">
            <StackPanel>
                <TextBlock Text="OPTIONS" Style="{StaticResource SectionLabel}" Margin="0,0,0,10"/>
                <CheckBox Content="Start the download as soon as it is added"
                          IsChecked="{Binding StartImmediately}" Margin="0,0,0,9"/>
                <CheckBox Content="Skip this editor from now on (can be changed in Settings)"
                          IsChecked="{Binding SkipEditorFromNow}"/>
            </StackPanel>
        </Border>

        <!-- ================= Footer ================= -->
        <Grid Margin="20,12,20,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="{Binding Error}" Foreground="{DynamicResource DangerBrush}" FontSize="12"
                       TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,12,0"/>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Content="Add" IsDefault="True" Style="{StaticResource PrimaryButton}"
                        MinWidth="96" Margin="0,0,8,0" Click="Ok_Click"/>
                <Button Content="Cancel" IsCancel="True" Style="{StaticResource SecondaryButton}"
                        MinWidth="96"/>
            </StackPanel>
        </Grid>
    </StackPanel>
</Window>
