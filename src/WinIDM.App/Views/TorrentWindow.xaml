<Window x:Class="WinIDM.App.Views.TorrentWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Torrent"
        Width="1120" Height="820" MinWidth="880" MinHeight="700"
        WindowStartupLocation="CenterOwner">

    <Window.Resources>
        <!-- ===================== Tab strip: pill tabs, like the main window ===================== -->
        <Style TargetType="TabControl">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabControl">
                        <Grid KeyboardNavigation.TabNavigation="Local">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <TabPanel x:Name="HeaderPanel" Grid.Row="0" IsItemsHost="True" Panel.ZIndex="1"
                                      Margin="0,0,0,10" Background="Transparent"
                                      KeyboardNavigation.TabIndex="1"/>
                            <ContentPresenter x:Name="PART_SelectedContentHost" Grid.Row="1"
                                              ContentSource="SelectedContent"
                                              SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="TabItem">
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="Padding" Value="14,6"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="Bd" CornerRadius="16" Padding="{TemplateBinding Padding}"
                                Background="Transparent" BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1" SnapsToDevicePixels="True" Cursor="Hand">
                            <ContentPresenter x:Name="HeaderSite" ContentSource="Header"
                                              HorizontalAlignment="Center" VerticalAlignment="Center"
                                              RecognizesAccessKey="True" TextElement.FontSize="12"
                                              TextElement.Foreground="{DynamicResource TabTextBrush}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentBrush}"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                <Setter TargetName="HeaderSite" Property="TextElement.Foreground"
                                        Value="{DynamicResource AccentTextBrush}"/>
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsMouseOver" Value="True"/>
                                    <Condition Property="IsSelected" Value="False"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentSoftBrush}"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentSoftBorderBrush}"/>
                                <Setter TargetName="HeaderSite" Property="TextElement.Foreground"
                                        Value="{DynamicResource AccentBrush}"/>
                            </MultiTrigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ===================== Compact per-row actions in the torrent list ===================== -->
        <Style x:Key="RowActionButton" TargetType="Button" BasedOn="{StaticResource GhostButton}">
            <Setter Property="Padding" Value="9,3"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="FontSize" Value="12.5"/>
        </Style>

        <Style x:Key="RowDeleteButton" TargetType="Button" BasedOn="{StaticResource RowActionButton}">
            <Setter Property="Foreground" Value="{DynamicResource DangerBrush}"/>
            <Setter Property="Margin" Value="0"/>
        </Style>

        <!-- ===================== Draggable hairline between list and details ===================== -->
        <Style x:Key="RowSplitter" TargetType="GridSplitter">
            <Setter Property="Height" Value="12"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Cursor" Value="SizeNS"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="GridSplitter">
                        <Border Background="Transparent">
                            <Border Width="46" Height="4" CornerRadius="2" HorizontalAlignment="Center"
                                    VerticalAlignment="Center" Background="{DynamicResource BorderBrush}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ===================== File table ===================== -->
        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="RowBackground" Value="Transparent"/>
            <Setter Property="AlternatingRowBackground" Value="Transparent"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="HorizontalGridLinesBrush" Value="{DynamicResource GridLineBrush}"/>
            <Setter Property="VerticalGridLinesBrush" Value="{DynamicResource GridLineBrush}"/>
        </Style>

        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource ColumnHeaderTextBrush}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="10,7"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="BorderBrush" Value="{DynamicResource GridLineBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridColumnHeader">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"
                                              RecognizesAccessKey="True"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="DataGridRow">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource ListHoverBrush}"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="DataGridCell">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridCell">
                        <Border Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource ListHoverBrush}"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}"/>
                    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <DockPanel>
        <!-- ===================== Page header ===================== -->
        <Border DockPanel.Dock="Top" Padding="20,18,20,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Width="42" Height="42" CornerRadius="13" VerticalAlignment="Center"
                        Background="{DynamicResource AccentSoftBrush}"
                        BorderBrush="{DynamicResource AccentSoftBorderBrush}" BorderThickness="1">
                    <TextBlock Text="&#xE896;" FontFamily="Segoe MDL2 Assets" FontSize="20"
                               Foreground="{DynamicResource AccentBrush}"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>

                <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="Torrent" Style="{StaticResource Heading}"/>
                    <TextBlock Style="{StaticResource Muted}" Margin="0,2,0,0" TextWrapping="Wrap"
                               Text="Add magnet links or .torrent files, then tune files, trackers and speed limits."/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ===================== Footer: window status and the primary action ===================== -->
        <Border DockPanel.Dock="Bottom" Margin="20,14,20,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="{Binding Status}" VerticalAlignment="Center"
                           Margin="0,0,16,0" TextTrimming="CharacterEllipsis" ToolTip="{Binding Status}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource Muted}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Status}" Value="">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="Add" Style="{StaticResource PrimaryButton}" MinWidth="96"
                            Command="{Binding AddCommand}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ===================== Body ===================== -->
        <Grid Margin="20,0,20,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Add torrent -->
            <Border Grid.Row="0" Style="{StaticResource Card}" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="Add torrent" Style="{StaticResource Subheading}"/>
                    <DockPanel Margin="0,10,0,0">
                        <Button DockPanel.Dock="Right" Content="Torrent file..." Margin="8,0,0,0"
                                VerticalAlignment="Center" Click="PickTorrent_Click"/>
                        <TextBox Text="{Binding Source, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="Paste a magnet: link or the path to a .torrent file"/>
                    </DockPanel>
                </StackPanel>
            </Border>

            <!-- Torrent list and the selected torrent's details -->
            <Border Grid.Row="1" Style="{StaticResource Card}" Padding="6">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="2*" MinHeight="120"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="3*" MinHeight="200"/>
                    </Grid.RowDefinitions>

                    <ListView x:Name="TorrentList" Grid.Row="0" ItemsSource="{Binding Items}"
                              SelectedItem="{Binding Selected, Mode=TwoWay}" SelectionMode="Single"
                              ScrollViewer.HorizontalScrollBarVisibility="Auto">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="Name" Width="230">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis"
                                                       MaxWidth="220"/>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="State" Width="140">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border x:Name="Pill" CornerRadius="9" Padding="8,3"
                                                    HorizontalAlignment="Left"
                                                    Background="{DynamicResource AccentSoftBrush}">
                                                <TextBlock x:Name="PillText" Text="{Binding StatusText}"
                                                           FontSize="11" TextTrimming="CharacterEllipsis" MaxWidth="112"
                                                           Foreground="{DynamicResource AccentBrush}"/>
                                            </Border>
                                            <DataTemplate.Triggers>
                                                <DataTrigger Binding="{Binding Paused}" Value="True">
                                                    <Setter TargetName="Pill" Property="Background"
                                                            Value="{DynamicResource SurfaceAltBrush}"/>
                                                    <Setter TargetName="PillText" Property="Foreground"
                                                            Value="{DynamicResource TextSecondaryBrush}"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding HasError}" Value="True">
                                                    <Setter TargetName="Pill" Property="Background"
                                                            Value="{DynamicResource DangerSoftBrush}"/>
                                                    <Setter TargetName="PillText" Property="Foreground"
                                                            Value="{DynamicResource DangerBrush}"/>
                                                </DataTrigger>
                                            </DataTemplate.Triggers>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="Progress" Width="150">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <Grid Width="138" VerticalAlignment="Center">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <ProgressBar Grid.Column="0" Value="{Binding Progress, Mode=OneWay}"
                                                             Maximum="100"
                                                             IsIndeterminate="{Binding IsIndeterminate}"
                                                             Style="{StaticResource RowProgress}"/>
                                                <TextBlock Grid.Column="1" Text="{Binding ProgressText}"
                                                           FontSize="11" Margin="8,0,0,0"
                                                           Foreground="{DynamicResource TextSecondaryBrush}"/>
                                            </Grid>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="Peers" Width="130" DisplayMemberBinding="{Binding PeersText}"/>
                                <GridViewColumn Header="Speed" Width="90" DisplayMemberBinding="{Binding SpeedText}"/>
                                <GridViewColumn Header="Actions" Width="290">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal">
                                                <Button Content="Pause" Style="{StaticResource RowActionButton}"
                                                        Command="{Binding DataContext.PauseCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}"/>
                                                <Button Content="Resume" Style="{StaticResource RowActionButton}"
                                                        Command="{Binding DataContext.ResumeCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}"/>
                                                <Button Content="Remove" Style="{StaticResource RowActionButton}"
                                                        Command="{Binding DataContext.RemoveCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}"/>
                                                <Button Content="Delete file" Style="{StaticResource RowDeleteButton}"
                                                        Command="{Binding DataContext.DeleteWithFilesCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                            </GridView>
                        </ListView.View>
                    </ListView>

                    <!-- Empty state: no torrents in the list yet -->
                    <Border Grid.Row="0" Background="Transparent" IsHitTestVisible="False"
                            Visibility="{Binding ElementName=TorrentList, Path=HasItems, Converter={StaticResource InvBoolToVis}}">
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="380">
                            <Border Width="52" Height="52" CornerRadius="17" HorizontalAlignment="Center"
                                    Background="{DynamicResource AccentSoftBrush}">
                                <TextBlock Text="&#xE896;" FontFamily="Segoe MDL2 Assets" FontSize="22"
                                           Foreground="{DynamicResource AccentBrush}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="No torrents yet" FontSize="15" FontWeight="SemiBold"
                                       HorizontalAlignment="Center" Margin="0,14,0,4"/>
                            <TextBlock Style="{StaticResource Muted}" TextAlignment="Center" TextWrapping="Wrap"
                                       Text="Add a magnet link or a .torrent file to see it here."/>
                        </StackPanel>
                    </Border>

                    <GridSplitter Grid.Row="1" Style="{StaticResource RowSplitter}"
                                  ResizeDirection="Rows" ResizeBehavior="PreviousAndNext"/>

                    <!-- Details of the selected torrent -->
                    <Border Grid.Row="2" Style="{StaticResource SoftCard}" Padding="14">
                        <DockPanel IsEnabled="{Binding HasSelection}" LastChildFill="True">
                            <StackPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                                <TextBlock Text="{Binding Selected.Name, FallbackValue='Select a torrent for details'}"
                                           Style="{StaticResource Subheading}"
                                           TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="{Binding ErrorText}" TextWrapping="Wrap" Margin="0,3,0,0"
                                           FontSize="11.5" Foreground="{DynamicResource DangerBrush}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding ErrorText}" Value="">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>

                            <TabControl>
                                <TabItem Header="Files">
                                    <DockPanel Margin="0,2,0,0">
                                        <TextBlock DockPanel.Dock="Top" Margin="0,0,0,8"
                                                   Style="{StaticResource Muted}" TextWrapping="Wrap"
                                                   Text="Priority can be changed while downloading. Skip = do not download."
                                                   Visibility="{Binding HasMetadata, Converter={StaticResource BoolToVis}}"/>
                                        <TextBlock DockPanel.Dock="Top" Margin="0,0,0,8"
                                                   Style="{StaticResource Muted}" TextWrapping="Wrap"
                                                   Text="Metadata is not available yet. The file list appears once metadata is fetched."
                                                   Visibility="{Binding HasMetadata, Converter={StaticResource InvBoolToVis}}"/>
                                        <DataGrid ItemsSource="{Binding Files}" AutoGenerateColumns="False"
                                                  CanUserAddRows="False" CanUserDeleteRows="False"
                                                  IsReadOnly="True" SelectionMode="Single">
                                            <DataGrid.Columns>
                                                <DataGridTextColumn Header="Path" Binding="{Binding Path}" Width="*"/>
                                                <DataGridTextColumn Header="Size" Binding="{Binding SizeText}" Width="100"/>
                                                <DataGridTextColumn Header="Progress" Binding="{Binding ProgressText}" Width="90"/>
                                                <DataGridTemplateColumn Header="Priority" Width="140">
                                                    <DataGridTemplateColumn.CellTemplate>
                                                        <DataTemplate>
                                                            <ComboBox ItemsSource="{Binding DataContext.PriorityOptions, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                      DisplayMemberPath="Label" SelectedValuePath="Value"
                                                                      SelectedValue="{Binding Priority, Mode=OneWay}"
                                                                      SelectionChanged="FilePriority_SelectionChanged"/>
                                                        </DataTemplate>
                                                    </DataGridTemplateColumn.CellTemplate>
                                                </DataGridTemplateColumn>
                                            </DataGrid.Columns>
                                        </DataGrid>
                                    </DockPanel>
                                </TabItem>

                                <TabItem Header="Statistics">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                                  HorizontalScrollBarVisibility="Disabled">
                                        <StackPanel Margin="0,2,0,0">
                                            <Border Style="{StaticResource SoftCard}" Padding="14">
                                                <TextBlock Text="{Binding DetailText}" TextWrapping="Wrap" FontSize="12.5"/>
                                            </Border>
                                            <CheckBox Content="Sequential download" Margin="0,14,0,0"
                                                      IsChecked="{Binding Sequential, Mode=OneWay}"
                                                      Command="{Binding ToggleSequentialCommand}"/>
                                            <WrapPanel Margin="0,12,0,0">
                                                <Button Content="Recheck pieces" Margin="0,0,8,8"
                                                        Command="{Binding RecheckCommand}"/>
                                                <Button Content="Reannounce to tracker" Margin="0,0,8,8"
                                                        Command="{Binding ReannounceCommand}"/>
                                                <Button Content="Copy magnet link" Margin="0,0,8,8"
                                                        Command="{Binding CopyMagnetCommand}"/>
                                                <Button Content="Peers..." Margin="0,0,8,8" Command="{Binding ShowPeersCommand}"
                                                        Visibility="{Binding ShowPeerInfo, Converter={StaticResource BoolToVis}}"/>
                                                <Button Content="Save .torrent file..." Margin="0,0,0,8"
                                                        Click="SaveTorrent_Click"/>
                                            </WrapPanel>
                                        </StackPanel>
                                    </ScrollViewer>
                                </TabItem>

                                <TabItem Header="Trackers">
                                    <DockPanel Margin="0,2,0,0">
                                        <TextBlock DockPanel.Dock="Top" Style="{StaticResource Muted}"
                                                   TextWrapping="Wrap" Margin="0,0,0,8"
                                                   Text="One URL per line (http, https, or udp). Invalid trackers are ignored."/>
                                        <Button DockPanel.Dock="Bottom" Content="Save trackers"
                                                Style="{StaticResource PrimaryButton}"
                                                HorizontalAlignment="Right" Margin="0,12,0,0"
                                                Command="{Binding ApplyTrackersCommand}"/>
                                        <TextBox Text="{Binding TrackersText, UpdateSourceTrigger=PropertyChanged}"
                                                 AcceptsReturn="True" TextWrapping="NoWrap" MinHeight="60"
                                                 FontFamily="Consolas" FontSize="12"
                                                 VerticalScrollBarVisibility="Auto"
                                                 HorizontalScrollBarVisibility="Auto"/>
                                    </DockPanel>
                                </TabItem>

                                <TabItem Header="Limits">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                                  HorizontalScrollBarVisibility="Disabled">
                                        <StackPanel Margin="0,2,0,0">
                                            <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap"
                                                       Margin="0,0,0,12"
                                                       Text="Speed limit for this torrent only, in KB/s. 0 means no limit."/>
                                            <Border Style="{StaticResource SoftCard}" Padding="14">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto"/>
                                                        <RowDefinition Height="Auto"/>
                                                    </Grid.RowDefinitions>

                                                    <TextBlock Grid.Row="0" Grid.Column="0"
                                                               Text="Download limit (KB/s)"
                                                               VerticalAlignment="Center" Margin="0,0,16,10"/>
                                                    <TextBox Grid.Row="0" Grid.Column="1" Width="180" Margin="0,0,0,10"
                                                             Text="{Binding DownloadLimitText, UpdateSourceTrigger=PropertyChanged}"/>

                                                    <TextBlock Grid.Row="1" Grid.Column="0"
                                                               Text="Upload limit (KB/s)"
                                                               VerticalAlignment="Center" Margin="0,0,16,0"/>
                                                    <TextBox Grid.Row="1" Grid.Column="1" Width="180"
                                                             Text="{Binding UploadLimitText, UpdateSourceTrigger=PropertyChanged}"/>
                                                </Grid>
                                            </Border>
                                            <Button Content="Save limits" Style="{StaticResource PrimaryButton}"
                                                    HorizontalAlignment="Right" Margin="0,12,0,0"
                                                    Command="{Binding ApplyLimitsCommand}"/>
                                        </StackPanel>
                                    </ScrollViewer>
                                </TabItem>
                            </TabControl>
                        </DockPanel>
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </DockPanel>
</Window>
