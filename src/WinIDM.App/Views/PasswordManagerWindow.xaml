<Window x:Class="WinIDM.App.Views.PasswordManagerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Password manager" Width="980" Height="690" MinWidth="920" MinHeight="630"
        WindowStartupLocation="CenterOwner">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ================= Page header ================= -->
        <DockPanel Grid.Row="0" Margin="20,18,20,12">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center"
                        Visibility="{Binding ShowContent, Converter={StaticResource BoolToVis}}">
                <Button Content="Change PIN..." Style="{StaticResource GhostButton}" Margin="0,0,6,0" Click="ChangePin_Click"/>
                <Button Content="Lock" Click="Lock_Click"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal">
                <Border Width="40" Height="40" CornerRadius="12" Background="{DynamicResource AccentSoftBrush}"
                        BorderBrush="{DynamicResource AccentSoftBorderBrush}" BorderThickness="1">
                    <TextBlock Text="&#xE72E;" FontFamily="Segoe MDL2 Assets" FontSize="18"
                               Foreground="{DynamicResource AccentBrush}"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="Password manager" Style="{StaticResource Heading}"/>
                    <TextBlock Text="Site logins encrypted on this PC and unlocked with your PIN."
                               Style="{StaticResource Muted}" Margin="0,2,0,0"/>
                </StackPanel>
            </StackPanel>
        </DockPanel>

        <!-- ================= Body ================= -->
        <Grid Grid.Row="1" Margin="20,0,20,0">

            <!-- Not set up yet -->
            <Border Style="{StaticResource Card}" HorizontalAlignment="Center" VerticalAlignment="Center"
                    MaxWidth="640" Visibility="{Binding ShowSetup, Converter={StaticResource BoolToVis}}">
                <StackPanel Orientation="Horizontal">
                    <Border Width="40" Height="40" CornerRadius="12" VerticalAlignment="Top"
                            Background="{DynamicResource AccentSoftBrush}"
                            BorderBrush="{DynamicResource AccentSoftBorderBrush}" BorderThickness="1">
                        <TextBlock Text="&#xE710;" FontFamily="Segoe MDL2 Assets" FontSize="18"
                                   Foreground="{DynamicResource AccentBrush}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Margin="14,0,0,0" MaxWidth="520">
                        <TextBlock TextWrapping="Wrap"
                                   Text="The password manager is not set up yet. Set it up with a PIN (6-16 characters). Passwords are encrypted (AES-256-GCM); the master key is wrapped by the PIN and by DPAPI for this Windows account."/>
                        <Button Content="Set up with PIN..." Style="{StaticResource PrimaryButton}"
                                HorizontalAlignment="Left" Margin="0,14,0,0" Click="Setup_Click"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Locked -->
            <Border Style="{StaticResource Card}" HorizontalAlignment="Center" VerticalAlignment="Center"
                    MaxWidth="640" Visibility="{Binding ShowUnlock, Converter={StaticResource BoolToVis}}">
                <StackPanel Orientation="Horizontal">
                    <Border Width="40" Height="40" CornerRadius="12" VerticalAlignment="Top"
                            Background="{DynamicResource AccentSoftBrush}"
                            BorderBrush="{DynamicResource AccentSoftBorderBrush}" BorderThickness="1">
                        <TextBlock Text="&#xE72E;" FontFamily="Segoe MDL2 Assets" FontSize="18"
                                   Foreground="{DynamicResource AccentBrush}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Margin="14,0,0,0" MaxWidth="520">
                        <TextBlock TextWrapping="Wrap"
                                   Text="The password manager is locked. Unlock it with your PIN to view or manage passwords. The session ends after 5 minutes of inactivity."/>
                        <Button Content="Unlock with PIN..." Style="{StaticResource PrimaryButton}"
                                HorizontalAlignment="Left" Margin="0,14,0,0" Click="Unlock_Click"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Content when unlocked: account list, then the add/edit form -->
            <Grid Visibility="{Binding ShowContent, Converter={StaticResource BoolToVis}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Accounts -->
                <Border Grid.Row="0" Style="{StaticResource Card}" Margin="0,0,0,12">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*" MinHeight="120"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <DockPanel Grid.Row="0" Margin="0,0,0,10">
                            <TextBlock DockPanel.Dock="Right" Text="{Binding CountText}" Style="{StaticResource Muted}"
                                       FontSize="11.5" Margin="12,0,0,0" VerticalAlignment="Center"/>
                            <Border Height="34" CornerRadius="17" Padding="12,0" MaxWidth="420"
                                    HorizontalAlignment="Left"
                                    Background="{DynamicResource SurfaceAltBrush}"
                                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Left" Text="&#xE721;" FontFamily="Segoe MDL2 Assets"
                                               FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}"
                                               Margin="0,0,8,0"/>
                                    <TextBox Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}"
                                             ToolTip="Search by site or username"
                                             Background="Transparent" BorderThickness="0" Padding="0" FontSize="12.5"/>
                                </DockPanel>
                            </Border>
                        </DockPanel>

                        <ListView Grid.Row="1" ItemsSource="{Binding Visible}"
                                  SelectedItem="{Binding Selected, Mode=TwoWay}" SelectionMode="Single">
                            <ListView.View>
                                <GridView>
                                    <GridViewColumn Header="Site" Width="390" DisplayMemberBinding="{Binding Origin}"/>
                                    <GridViewColumn Header="Username" Width="320" DisplayMemberBinding="{Binding Username}"/>
                                    <GridViewColumn Header="Password" Width="110">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="••••••••" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                </GridView>
                            </ListView.View>
                        </ListView>

                        <WrapPanel Grid.Row="2" Margin="0,10,0,0">
                            <Button Content="New account" Margin="0,0,8,4" Click="NewEntry_Click"/>
                            <Button Content="Edit" Margin="0,0,8,4" Click="Edit_Click"/>
                            <Button Content="Copy password" Margin="0,0,8,4" Click="Copy_Click"/>
                            <Button Content="Delete" Style="{StaticResource DangerButton}" Margin="0,0,8,4" Click="Delete_Click"/>
                            <Button Content="Import CSV..." Style="{StaticResource GhostButton}" Margin="0,0,8,4" Click="Import_Click"/>
                            <Button Content="Export CSV..." Style="{StaticResource GhostButton}" Margin="0,0,8,4" Click="Export_Click"/>
                        </WrapPanel>
                    </Grid>
                </Border>

                <!-- Add / edit form -->
                <Border Grid.Row="1" Style="{StaticResource Card}">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right"
                                    Margin="0,12,0,0">
                            <Button Content="Clear" Margin="0,0,8,0" Click="ClearForm_Click"/>
                            <Button Content="Save" Style="{StaticResource PrimaryButton}" IsDefault="True" Click="Save_Click"/>
                        </StackPanel>

                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="16"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="16"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Site" Margin="0,0,0,4"/>
                                    <TextBox Text="{Binding FormOrigin, UpdateSourceTrigger=PropertyChanged}"
                                             ToolTip="Example: https://example.com"/>
                                </StackPanel>

                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Username" Margin="0,0,0,4"/>
                                    <TextBox Text="{Binding FormUsername, UpdateSourceTrigger=PropertyChanged}"/>
                                </StackPanel>

                                <StackPanel Grid.Column="4">
                                    <TextBlock Text="Password" Margin="0,0,0,4"/>
                                    <PasswordBox x:Name="PwBox"/>
                                </StackPanel>
                            </Grid>

                            <Border Style="{StaticResource Divider}" Margin="0,12"/>

                            <TextBlock Text="GENERATOR" Style="{StaticResource SectionLabel}" Margin="0,0,0,10"/>

                            <DockPanel Margin="0,0,0,10">
                                <Button DockPanel.Dock="Right" Content="Generate" VerticalAlignment="Bottom"
                                        Margin="8,0,0,0" Click="Generate_Click"/>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Generator: length" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBox Text="{Binding GeneratorLength}" Width="56"/>
                                </StackPanel>
                            </DockPanel>

                            <WrapPanel>
                                <CheckBox Content="Lowercase" IsChecked="{Binding UseLower}" Margin="0,0,16,0"/>
                                <CheckBox Content="Uppercase" IsChecked="{Binding UseUpper}" Margin="0,0,16,0"/>
                                <CheckBox Content="Digits" IsChecked="{Binding UseDigits}" Margin="0,0,16,0"/>
                                <CheckBox Content="Symbols" IsChecked="{Binding UseSymbols}" Margin="0,0,16,0"/>
                            </WrapPanel>
                        </StackPanel>
                    </DockPanel>
                </Border>
            </Grid>
        </Grid>

        <!-- ================= Status line ================= -->
        <TextBlock Grid.Row="2" Text="{Binding Status}" Style="{StaticResource Muted}" TextWrapping="Wrap"
                   Margin="20,10,20,16"/>
    </Grid>
</Window>
