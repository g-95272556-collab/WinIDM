<Window x:Class="WinIDM.App.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:WinIDM.App.ViewModels"
        xmlns:svc="clr-namespace:WinIDM.App.Services"
        Title="Settings"
        Width="900" Height="660" MinWidth="760" MinHeight="540"
        WindowStartupLocation="CenterOwner">
    <Window.Resources>
        <!-- Visibility by setting kind (Kind) -->
        <Style x:Key="ForBool" TargetType="FrameworkElement">
            <Setter Property="Visibility" Value="Collapsed"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Kind}" Value="{x:Static svc:SettingKind.Bool}">
                    <Setter Property="Visibility" Value="Visible"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="ForNonBool" TargetType="FrameworkElement">
            <Setter Property="Visibility" Value="Visible"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Kind}" Value="{x:Static svc:SettingKind.Bool}">
                    <Setter Property="Visibility" Value="Collapsed"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="ForInt" TargetType="FrameworkElement" BasedOn="{StaticResource ForNonBool}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding Kind}" Value="{x:Static svc:SettingKind.Int}">
                    <Setter Property="Visibility" Value="Visible"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Kind}" Value="{x:Static svc:SettingKind.Text}">
                    <Setter Property="Visibility" Value="Collapsed"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Kind}" Value="{x:Static svc:SettingKind.Choice}">
                    <Setter Property="Visibility" Value="Collapsed"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="ForText" TargetType="FrameworkElement" BasedOn="{StaticResource ForNonBool}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding Kind}" Value="{x:Static svc:SettingKind.Text}">
                    <Setter Property="Visibility" Value="Visible"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Kind}" Value="{x:Static svc:SettingKind.Int}">
                    <Setter Property="Visibility" Value="Collapsed"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Kind}" Value="{x:Static svc:SettingKind.Choice}">
                    <Setter Property="Visibility" Value="Collapsed"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="ForChoice" TargetType="FrameworkElement" BasedOn="{StaticResource ForNonBool}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding Kind}" Value="{x:Static svc:SettingKind.Choice}">
                    <Setter Property="Visibility" Value="Visible"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Kind}" Value="{x:Static svc:SettingKind.Int}">
                    <Setter Property="Visibility" Value="Collapsed"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Kind}" Value="{x:Static svc:SettingKind.Text}">
                    <Setter Property="Visibility" Value="Collapsed"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- ===================== Left rail: category navigation ===================== -->
        <Style x:Key="CategoryListItem" TargetType="ListBoxItem">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="Margin" Value="0,1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd" CornerRadius="9" Background="Transparent" BorderThickness="1"
                                BorderBrush="Transparent" Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ListHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentSoftBrush}"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentSoftBorderBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CategoryList" TargetType="ListBox">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
        </Style>

        <!-- ===================== Settings rows ===================== -->
        <!-- One row of a group card: label on the left, the input in the fixed right-hand column.
             The label TextBlock and its input share the inner Grid so automation can walk from the
             label up to the row that owns the Edit. -->
        <Style x:Key="SettingRow" TargetType="Border">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="CornerRadius" Value="9"/>
            <Setter Property="Padding" Value="8,7"/>
            <Setter Property="Margin" Value="0,1"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource ListHoverBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <DataTemplate x:Key="SettingItemTemplate" DataType="{x:Type vm:SettingItemViewModel}">
            <Border Style="{StaticResource SettingRow}">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="240"/>
                        </Grid.ColumnDefinitions>

                        <CheckBox Grid.ColumnSpan="2" Content="{Binding Label}" IsChecked="{Binding BoolValue}"
                                  Style="{StaticResource ForBool}"/>

                        <TextBlock Grid.Column="0" Text="{Binding Label}" TextWrapping="Wrap" Margin="0,0,16,0"
                                   Style="{StaticResource ForNonBool}"/>

                        <TextBox Grid.Column="1" Width="180" HorizontalAlignment="Left"
                                 Text="{Binding IntText, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource ForInt}" ToolTip="Whole number, 0 or more"/>

                        <TextBox Grid.Column="1" Width="240" HorizontalAlignment="Left"
                                 Text="{Binding TextValue, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource ForText}"/>

                        <ComboBox Grid.Column="1" Width="200" HorizontalAlignment="Left"
                                  ItemsSource="{Binding ChoiceOptions}" SelectedItem="{Binding ChoiceValue}"
                                  Style="{StaticResource ForChoice}"/>
                    </Grid>

                    <Border Background="{DynamicResource ProgressTrackBrush}" CornerRadius="9" Padding="8,2"
                            HorizontalAlignment="Left" Margin="0,4,0,0">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding StatusText}" Value="">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock Text="{Binding StatusText}" FontSize="11" Style="{StaticResource Muted}"/>
                    </Border>
                </StackPanel>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsPending}" Value="True">
                    <Setter Property="Opacity" Value="0.6"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- One group ("Downloads", "Windows", ...) as a card with a SectionLabel header. -->
        <DataTemplate x:Key="SettingGroupTemplate" DataType="{x:Type vm:SettingGroupViewModel}">
            <Border Style="{StaticResource Card}" Padding="16,14,16,10" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="{Binding Title}" Style="{StaticResource SectionLabel}" Margin="8,2,8,8"/>
                    <ItemsControl ItemsSource="{Binding Items}" ItemTemplate="{StaticResource SettingItemTemplate}"/>
                </StackPanel>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <DockPanel>
        <!-- ================= Page header ================= -->
        <Border DockPanel.Dock="Top" Padding="20,18,20,12">
            <StackPanel Orientation="Horizontal">
                <Grid Width="40" Height="40" VerticalAlignment="Center">
                    <Border CornerRadius="12" Background="{DynamicResource AccentSoftBrush}"
                            BorderBrush="{DynamicResource AccentSoftBorderBrush}" BorderThickness="1"/>
                    <TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets" FontSize="19"
                               Foreground="{DynamicResource AccentBrush}"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Grid>
                <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="Settings" Style="{StaticResource Heading}"/>
                    <TextBlock Text="Preferences for downloads, notifications, the proxy, torrents and the browser."
                               Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- ================= Footer actions ================= -->
        <Border DockPanel.Dock="Bottom" Margin="20,14,20,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{Binding Footer}" Style="{StaticResource Muted}"
                           TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,16,0"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right"
                            VerticalAlignment="Center">
                    <Button Content="Reset this category" Style="{StaticResource SecondaryButton}"
                            Command="{Binding ResetCategoryCommand}" Margin="0,0,8,0"/>
                    <Button Content="Close" Style="{StaticResource PrimaryButton}" IsCancel="True"
                            Click="Close_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ================= Body: category rail + settings cards ================= -->
        <Grid Margin="20,0,20,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="210"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource Card}" Padding="8" Margin="0,0,12,0">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="CATEGORIES" Style="{StaticResource SectionLabel}"
                               Margin="8,4,8,8"/>
                    <ListBox Style="{StaticResource CategoryList}"
                             ItemContainerStyle="{StaticResource CategoryListItem}"
                             ItemsSource="{Binding Categories}" SelectedItem="{Binding SelectedCategory}"/>
                </DockPanel>
            </Border>

            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="{Binding SelectedCategory}" Style="{StaticResource Subheading}"
                           Margin="4,0,0,10"/>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                              Padding="0,0,6,0">
                    <ItemsControl ItemsSource="{Binding Groups}" ItemTemplate="{StaticResource SettingGroupTemplate}"/>
                </ScrollViewer>
            </Grid>
        </Grid>
    </DockPanel>
</Window>
