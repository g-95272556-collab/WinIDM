<Window x:Class="WinIDM.App.Views.BrowserWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:WinIDM.App.ViewModels"
        Title="WinIDM Browser"
        Width="1120" Height="740" MinWidth="700" MinHeight="460"
        WindowStartupLocation="CenterScreen"
        KeyDown="Window_KeyDown">
    <Window.Resources>
        <Style x:Key="NavButton" TargetType="Button">
            <Setter Property="Width" Value="34"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Margin" Value="2,0"/>
            <Setter Property="Padding" Value="0"/>
        </Style>
    </Window.Resources>

    <DockPanel>
        <!-- Tab strip -->
        <DockPanel DockPanel.Dock="Top" Background="{DynamicResource SurfaceBrush}" Margin="4,4,4,0">
            <Button DockPanel.Dock="Right" Content="+" ToolTip="New tab (Ctrl+T)" Width="30" Margin="4,0,0,0" Click="NewTab_Click"/>
            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                <ItemsControl x:Name="TabStrip">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:BrowserTabViewModel}">
                            <Border x:Name="TabBorder" Margin="0,0,4,0" Padding="8,4" MinWidth="140" MaxWidth="220"
                                    CornerRadius="4" BorderThickness="1"
                                    BorderBrush="{DynamicResource BorderBrush}"
                                    Background="{DynamicResource SurfaceAltBrush}">
                                <DockPanel>
                                    <Button DockPanel.Dock="Right" Content="x" Width="20" Height="20" Padding="0"
                                            Margin="6,0,0,0" ToolTip="Close tab"
                                            Click="CloseTab_Click" Tag="{Binding}"/>
                                    <Button Background="Transparent" BorderThickness="0" HorizontalContentAlignment="Left"
                                            Click="SelectTab_Click" Tag="{Binding}" Cursor="Hand">
                                        <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis"
                                                   Foreground="{DynamicResource TextPrimaryBrush}"/>
                                    </Button>
                                </DockPanel>
                            </Border>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                    <Setter TargetName="TabBorder" Property="Background" Value="{DynamicResource SurfaceBrush}"/>
                                    <Setter TargetName="TabBorder" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </DockPanel>

        <!-- Navigation and address bar -->
        <DockPanel DockPanel.Dock="Top" Margin="4,6,4,4">
            <Button DockPanel.Dock="Left" Content="&#x2190;" ToolTip="Back" Style="{StaticResource NavButton}" Click="Back_Click"/>
            <Button DockPanel.Dock="Left" Content="&#x2192;" ToolTip="Forward" Style="{StaticResource NavButton}" Click="Forward_Click"/>
            <Button DockPanel.Dock="Left" Content="&#x21BB;" ToolTip="Reload (F5)" Style="{StaticResource NavButton}" Click="Reload_Click"/>
            <Button DockPanel.Dock="Left" Content="&#x2302;" ToolTip="Home" Style="{StaticResource NavButton}" Click="Home_Click"/>

            <Button DockPanel.Dock="Right" Content="&#x22EF;" ToolTip="Menu" Style="{StaticResource NavButton}" Margin="6,0,0,0" Click="Menu_Click">
                <Button.ContextMenu>
                    <ContextMenu x:Name="MainMenu" Opened="MainMenu_Opened">
                        <MenuItem Header="New tab" Click="NewTab_Click"/>
                        <MenuItem Header="New incognito window" Click="NewIncognito_Click"/>
                        <Separator/>
                        <MenuItem Header="Bookmarks…" Click="Bookmarks_Click"/>
                        <MenuItem Header="History…" Click="History_Click"/>
                        <MenuItem Header="Password manager…" Click="Passwords_Click"/>
                        <MenuItem Header="Password audit (duplicates, strength, export)…" Click="OpenPasswordAudit_Click"/>
                        <MenuItem Header="Site permissions…" Click="OpenPermissions_Click"/>
                        <MenuItem Header="Import bookmarks (HTML)…" Click="ImportBookmarks_Click"/>
                        <MenuItem Header="Export bookmarks (HTML)…" Click="ExportBookmarks_Click"/>
                        <MenuItem Header="Save page (MHTML/PDF)…" Click="SavePage_Click"/>
                        <MenuItem Header="Saved pages…" Click="SavedPages_Click"/>
                        <MenuItem Header="Desktop mode (this tab)" Click="Desktop_Click" x:Name="DesktopMenu" IsCheckable="True"/>
                        <Separator/>
                        <MenuItem Header="Site grabber…" Click="OpenGrabber_Click"/>
                        <MenuItem Header="Reader mode (with speech)…" Click="OpenReader_Click"/>
                        <MenuItem Header="Edit home page shortcuts…" Click="OpenShortcuts_Click"/>
                        <MenuItem x:Name="SearchEngineMenu" Header="Search engine"/>
                        <Separator/>
                        <MenuItem Header="Ad blocker and filters…" Click="OpenBlocker_Click"/>
                        <MenuItem x:Name="SiteAdblockItem" Header="Ad blocker for this site" IsCheckable="True" Click="SiteAdblock_Click"/>
                        <MenuItem Header="Hide element (pick on page)…" Click="StartElementPicker_Click"/>
                        <Separator/>
                        <MenuItem Header="Copy link" Click="CopyLink_Click"/>
                        <MenuItem Header="Clear browsing data…" Click="ClearData_Click"/>
                    </ContextMenu>
                </Button.ContextMenu>
            </Button>
            <Button DockPanel.Dock="Right" x:Name="ScriptButton" Content="Scripts" ToolTip="User scripts and script commands"
                    Padding="8,2" Margin="6,0,0,0" Click="Menu_Click">
                <Button.ContextMenu>
                    <ContextMenu x:Name="ScriptMenu">
                        <MenuItem Header="User script manager…" Click="OpenScriptManager_Click"/>
                        <Separator x:Name="ScriptMenuSeparator" Visibility="Collapsed"/>
                    </ContextMenu>
                </Button.ContextMenu>
            </Button>
            <Button DockPanel.Dock="Right" x:Name="MediaButton" Content="Media (0)" ToolTip="Show detected media"
                    Padding="8,2" Margin="6,0,0,0" Click="ToggleMedia_Click"/>
            <Button DockPanel.Dock="Right" x:Name="BookmarkButton" Content="&#x2606;" ToolTip="Add or remove bookmark"
                    Style="{StaticResource NavButton}" Margin="6,0,0,0" Click="Bookmark_Click"/>
            <Button DockPanel.Dock="Right" Content="Go" Padding="10,2" Margin="6,0,0,0" Click="Go_Click" IsDefault="True"/>
            <TextBox x:Name="AddressBox" Padding="8,4" ToolTip="Enter a URL or search term"
                     KeyDown="AddressBox_KeyDown" GotKeyboardFocus="AddressBox_GotFocus"/>
        </DockPanel>

        <!-- Status bar -->
        <Border DockPanel.Dock="Bottom" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,1,0,0" Padding="8,3">
            <DockPanel>
                <TextBlock x:Name="IncognitoLabel" Text="Incognito mode: history, bookmarks, and cookies are not saved" Visibility="Collapsed"
                           DockPanel.Dock="Right" Foreground="{DynamicResource AccentBrush}" Margin="12,0,0,0"/>
                <TextBlock x:Name="StatusText" Style="{StaticResource Muted}" TextTrimming="CharacterEllipsis"/>
            </DockPanel>
        </Border>

        <!-- Save password prompt (only after an HTTPS form is submitted) -->
        <Border x:Name="SavePromptBar" DockPanel.Dock="Bottom" Visibility="Collapsed"
                Background="{DynamicResource SurfaceAltBrush}" BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,1,0,0" Padding="8,4">
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="Not now" Padding="10,2" Margin="6,0,0,0" Click="SavePrompt_Dismiss_Click"/>
                <Button DockPanel.Dock="Right" Content="Save" Padding="10,2" Margin="6,0,0,0" Click="SavePrompt_Save_Click"/>
                <TextBlock x:Name="SavePromptText" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
            </DockPanel>
        </Border>

        <!-- Content: WebView2 and media panel -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <!-- Auto: the web view gets the full width while the media panel is collapsed. -->
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Grid x:Name="ViewHost" Grid.Column="0" Background="{DynamicResource WindowBackgroundBrush}"/>

            <Border Grid.Column="1" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1,0,0,0" Padding="12" x:Name="MediaPanel" Visibility="Collapsed" Width="320">
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                        <Button DockPanel.Dock="Right" Content="Close" Style="{StaticResource GhostButton}" Padding="10,3"
                                Click="ToggleMedia_Click"/>
                        <StackPanel>
                            <TextBlock Text="Detected media" FontWeight="SemiBold" FontSize="14"/>
                            <TextBlock Text="Everything this page loaded that looks playable." Style="{StaticResource Muted}"
                                       FontSize="11" Margin="0,2,0,0"/>
                        </StackPanel>
                    </DockPanel>
                    <TextBlock DockPanel.Dock="Bottom" Style="{StaticResource Muted}" FontSize="11" TextWrapping="Wrap" Margin="2,8,2,0"
                               Text="Detection uses the page's network requests. Nothing is downloaded until you choose it."/>
                    <ListBox x:Name="MediaList" Background="Transparent" BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="Bd" CornerRadius="10" Background="Transparent" BorderThickness="1"
                                                    BorderBrush="Transparent" Padding="10" Margin="0,0,0,6">
                                                <ContentPresenter/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SurfaceAltBrush}"/>
                                                </Trigger>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentSoftBrush}"/>
                                                    <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentSoftBorderBrush}"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Title, FallbackValue=media}" FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding Url}" Style="{StaticResource Muted}" FontSize="10"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                            <Border CornerRadius="7" Padding="6,1" Background="{DynamicResource AccentSoftBrush}"
                                                    VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Kind}" FontSize="10" FontWeight="SemiBold"
                                                           Foreground="{DynamicResource AccentBrush}"/>
                                            </Border>
                                            <TextBlock Text="{Binding Quality}" FontSize="10"
                                                       Margin="6,0,0,0" TextTrimming="CharacterEllipsis">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock" BasedOn="{StaticResource Muted}">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Quality}" Value="{x:Null}">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </StackPanel>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="8,0,0,0">
                                        <Button Content="Download" Style="{StaticResource PrimaryButton}" Padding="10,4"
                                                Tag="{Binding}" Click="DownloadMedia_Click"/>
                                        <Button Content="Quality…" Padding="10,4" Margin="0,4,0,0" Tag="{Binding}"
                                                Click="MediaQuality_Click"
                                                ToolTip="Show HLS/DASH variants and choose a quality before downloading"/>
                                        <Button Content="Play" Padding="10,4" Margin="0,4,0,0" Tag="{Binding}"
                                                Click="MediaPlay_Click"
                                                ToolTip="Open in the built-in video player"/>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>
        </Grid>
    </DockPanel>
</Window>
