<Window x:Class="WinIDM.App.Views.BrowserVideoPlayerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WinIDM video player"
        Width="900" Height="560" MinWidth="360" MinHeight="240"
        KeyDown="Window_KeyDown" Closed="Window_Closed" WindowStartupLocation="CenterOwner">
    <!-- The player keeps its original element tree: PiP hides the control bar and full screen hides the seek bar,
         so every named element must stay where the code-behind expects it. -->
    <Window.Resources>
        <!-- Compact control-bar buttons: the whole bar has to fit on one row at the default window size. -->
        <Style x:Key="MediaPrimary" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="12,4"/>
        </Style>
        <Style x:Key="MediaSecondary" TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="9,4"/>
        </Style>
        <Style x:Key="MediaGhost" TargetType="Button" BasedOn="{StaticResource GhostButton}">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="7,4"/>
        </Style>
    </Window.Resources>

    <DockPanel>
        <!-- Control bar -->
        <WrapPanel x:Name="Toolbar" DockPanel.Dock="Top" Background="{DynamicResource SurfaceBrush}"
                   Margin="0" VerticalAlignment="Center">
            <Button Content="Play / Pause" Style="{StaticResource MediaPrimary}" Margin="10,6,6,8"
                    Click="PlayPause_Click"/>
            <Button Content="-30s" Style="{StaticResource MediaGhost}" Margin="0,6,1,8"
                    Click="Seek_Click" Tag="-30"/>
            <Button Content="-10s" Style="{StaticResource MediaGhost}" Margin="0,6,1,8"
                    Click="Seek_Click" Tag="-10"/>
            <Button Content="-5s" Style="{StaticResource MediaGhost}" Margin="0,6,1,8"
                    Click="Seek_Click" Tag="-5"/>
            <Button Content="+5s" Style="{StaticResource MediaGhost}" Margin="0,6,1,8"
                    Click="Seek_Click" Tag="5"/>
            <Button Content="+10s" Style="{StaticResource MediaGhost}" Margin="0,6,1,8"
                    Click="Seek_Click" Tag="10"/>
            <Button Content="+30s" Style="{StaticResource MediaGhost}" Margin="0,6,8,8"
                    Click="Seek_Click" Tag="30"/>
            <TextBlock Text="Speed" Style="{StaticResource Muted}" FontSize="12" VerticalAlignment="Center"
                       Margin="0,0,6,0"/>
            <ComboBox x:Name="SpeedBox" Width="68" FontSize="12" Margin="0,4,0,8"
                      SelectionChanged="Speed_Changed" SelectedIndex="2">
                <ComboBoxItem Content="0.5x" Tag="0.5"/>
                <ComboBoxItem Content="0.75x" Tag="0.75"/>
                <ComboBoxItem Content="1x" Tag="1"/>
                <ComboBoxItem Content="1.25x" Tag="1.25"/>
                <ComboBoxItem Content="1.5x" Tag="1.5"/>
                <ComboBoxItem Content="2x" Tag="2"/>
            </ComboBox>
            <CheckBox x:Name="RepeatBox" Content="Repeat" FontSize="12" Margin="10,4,0,8"/>
            <CheckBox x:Name="MuteBox" Content="Mute" FontSize="12" Margin="10,4,0,8" Click="Mute_Click"/>
            <Button Content="Subtitles..." Style="{StaticResource MediaSecondary}" Margin="10,6,4,8"
                    Click="Subtitles_Click"/>
            <Button Content="PiP" Style="{StaticResource MediaSecondary}" Margin="0,6,4,8"
                    Click="Pip_Click" ToolTip="Small window always on top"/>
            <Button Content="Full screen" Style="{StaticResource MediaSecondary}" Margin="0,6,4,8"
                    Click="Fullscreen_Click"/>
            <Button x:Name="LockButton" Content="Lock" Style="{StaticResource MediaSecondary}"
                    Margin="0,6,10,8" Click="Lock_Click"
                    ToolTip="Lock the controls to prevent accidental input. Press L to unlock."/>
        </WrapPanel>

        <!-- Progress bar -->
        <Border DockPanel.Dock="Bottom" Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="12,4">
            <DockPanel>
                <TextBlock x:Name="TimeText" DockPanel.Dock="Right" Text="00:00 / 00:00" Margin="12,0,2,0"
                           VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold"/>
                <TextBlock x:Name="InfoText" DockPanel.Dock="Right" Margin="12,0,0,0" VerticalAlignment="Center"
                           Style="{StaticResource Muted}" FontSize="12" Text=""/>
                <Slider x:Name="Seekbar" Margin="0" Minimum="0" Maximum="1" IsMoveToPointEnabled="True"
                        VerticalAlignment="Center"
                        PreviewMouseLeftButtonDown="Seekbar_Down" PreviewMouseLeftButtonUp="Seekbar_Up"/>
            </DockPanel>
        </Border>

        <!-- Media stage -->
        <Grid x:Name="Stage" Background="{DynamicResource WindowBackgroundBrush}">
            <MediaElement x:Name="Player" LoadedBehavior="Manual" UnloadedBehavior="Stop" Stretch="Uniform"
                          MediaOpened="Player_Opened" MediaEnded="Player_Ended" MediaFailed="Player_Failed"/>
            <Border x:Name="SubtitleBox" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="20,0,20,28"
                    Background="{DynamicResource SurfaceBrush}" Opacity="0.88"
                    CornerRadius="8" Padding="12,6" Visibility="Collapsed">
                <TextBlock x:Name="SubtitleText" TextWrapping="Wrap" TextAlignment="Center" FontSize="20"
                           Foreground="{DynamicResource TextPrimaryBrush}"/>
            </Border>
            <TextBlock x:Name="HintText" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,12,0,0"
                       Opacity="0.85" Foreground="{DynamicResource TextPrimaryBrush}" Text=""/>
        </Grid>
    </DockPanel>
</Window>
