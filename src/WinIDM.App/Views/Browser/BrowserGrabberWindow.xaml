<Window x:Class="WinIDM.App.Views.BrowserGrabberWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Site grabber"
        Width="1000" Height="640" MinWidth="820" MinHeight="520"
        WindowStartupLocation="CenterOwner" Closed="Window_Closed">
    <DockPanel>
        <!-- ================= Page header ================= -->
        <Border DockPanel.Dock="Top" Height="56" Padding="20,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid Width="32" Height="32" VerticalAlignment="Center">
                    <Border CornerRadius="9" Background="{DynamicResource AccentSoftBrush}"
                            BorderBrush="{DynamicResource AccentSoftBorderBrush}" BorderThickness="1"/>
                    <TextBlock Text="&#xE774;" FontFamily="Segoe MDL2 Assets" FontSize="16"
                               Foreground="{DynamicResource AccentBrush}"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Grid>
                <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="Site grabber" Style="{StaticResource Heading}"/>
                    <TextBlock Style="{StaticResource Muted}" FontSize="12" Margin="0,1,0,0"
                               TextTrimming="CharacterEllipsis"
                               Text="Crawl a site for links, then send the files you pick to downloads."/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ================= Footer actions ================= -->
        <Border DockPanel.Dock="Bottom" Margin="20,14,20,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" x:Name="StatusText" Style="{StaticResource Muted}" TextWrapping="Wrap"
                           VerticalAlignment="Center" Margin="0,0,16,0"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right"
                            VerticalAlignment="Center">
                    <Button x:Name="StopButton" Content="Stop" Style="{StaticResource SecondaryButton}"
                            IsEnabled="False" Margin="0,0,8,0" Click="Stop_Click"/>
                    <Button x:Name="RunButton" Content="Start crawl" Style="{StaticResource PrimaryButton}"
                            IsDefault="True" Click="Run_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ================= Body: options / results ================= -->
        <Grid Margin="20,0,20,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Crawl options -->
            <Border Grid.Column="0" Style="{StaticResource SoftCard}" Padding="14" Margin="0,0,12,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <TextBlock Text="Start URL" Style="{StaticResource SectionLabel}" Margin="0,0,0,5"/>
                        <TextBox x:Name="StartUrlBox" Margin="0,0,0,12"/>

                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Depth (0-10)" Style="{StaticResource SectionLabel}" Margin="0,0,0,5"/>
                                <TextBox x:Name="DepthBox" Text="1"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Max pages" Style="{StaticResource SectionLabel}" Margin="0,0,0,5"/>
                                <TextBox x:Name="PagesBox" Text="50"/>
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="Host scope" Style="{StaticResource SectionLabel}" Margin="0,0,0,5"/>
                        <ComboBox x:Name="ScopeBox" Margin="0,0,0,12" SelectedIndex="0">
                            <ComboBoxItem Content="Exact host only"/>
                            <ComboBoxItem Content="Same host and subdomains"/>
                            <ComboBoxItem Content="Any host"/>
                        </ComboBox>

                        <TextBlock Text="File URL regex (empty = all)" Style="{StaticResource SectionLabel}"
                                   Margin="0,0,0,5"/>
                        <TextBox x:Name="IncludeBox" Margin="0,0,0,12"/>

                        <TextBlock Text="Excluded regex" Style="{StaticResource SectionLabel}" Margin="0,0,0,5"/>
                        <TextBox x:Name="ExcludeBox" Margin="0,0,0,12"/>

                        <Border Style="{StaticResource Divider}" Margin="0,2,0,12"/>

                        <TextBlock Text="File types" Style="{StaticResource SectionLabel}" Margin="0,0,0,6"/>
                        <WrapPanel Margin="0,0,0,12">
                            <CheckBox x:Name="TypeDocs" Content="Documents" Margin="0,0,10,6"/>
                            <CheckBox x:Name="TypeVideo" Content="Video" Margin="0,0,10,6"/>
                            <CheckBox x:Name="TypeAudio" Content="Audio" Margin="0,0,10,6"/>
                            <CheckBox x:Name="TypeImages" Content="Images" Margin="0,0,10,6"/>
                            <CheckBox x:Name="TypeArchives" Content="Archives" Margin="0,0,10,6"/>
                            <CheckBox x:Name="TypeApps" Content="Applications" Margin="0,0,10,6"/>
                        </WrapPanel>

                        <TextBlock Text="Min / max size (KB, empty = no limit)" Style="{StaticResource SectionLabel}"
                                   Margin="0,0,0,5"/>
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="MinSizeBox" Grid.Column="0"/>
                            <TextBox x:Name="MaxSizeBox" Grid.Column="2"/>
                        </Grid>

                        <CheckBox x:Name="RobotsBox" Content="Respect robots.txt" IsChecked="True" Margin="0,0,0,12"/>

                        <TextBlock Text="Polite delay between requests (seconds, minimum 1)"
                                   Style="{StaticResource SectionLabel}" TextWrapping="Wrap" Margin="0,0,0,5"/>
                        <TextBox x:Name="DelayBox" Text="1" Margin="0,0,0,4"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- Results -->
            <Border Grid.Column="1" Style="{StaticResource Card}" Padding="14">
                <DockPanel>
                    <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                        <Button Content="Select all" Style="{StaticResource SecondaryButton}"
                                Margin="0,0,8,6" Click="SelectAll_Click"/>
                        <Button Content="Deselect all" Style="{StaticResource SecondaryButton}"
                                Margin="0,0,8,6" Click="SelectNone_Click"/>
                        <Button Content="Export links (.txt)..." Style="{StaticResource SecondaryButton}"
                                Margin="0,0,8,6" Click="Export_Click"/>
                        <Button Content="Send selection to downloads" Style="{StaticResource SecondaryButton}"
                                Margin="0,0,8,6" Click="Send_Click"/>
                        <TextBlock x:Name="CountText" Style="{StaticResource Muted}" VerticalAlignment="Center"
                                   Margin="4,0,0,6"/>
                    </WrapPanel>
                    <Border Style="{StaticResource SoftCard}" Padding="6">
                        <ListView x:Name="List" SelectionMode="Extended">
                            <ListView.View>
                                <GridView>
                                    <GridViewColumn Width="34">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <CheckBox IsChecked="{Binding Selected}" HorizontalAlignment="Center"/>
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                    <GridViewColumn Header="Type" DisplayMemberBinding="{Binding Extension}" Width="60"/>
                                    <GridViewColumn Header="Size" DisplayMemberBinding="{Binding Size}" Width="80"/>
                                    <GridViewColumn Header="Depth" DisplayMemberBinding="{Binding Depth}" Width="60"/>
                                    <GridViewColumn Header="Link" DisplayMemberBinding="{Binding Url}" Width="360"/>
                                </GridView>
                            </ListView.View>
                        </ListView>
                    </Border>
                </DockPanel>
            </Border>
        </Grid>
    </DockPanel>
</Window>
