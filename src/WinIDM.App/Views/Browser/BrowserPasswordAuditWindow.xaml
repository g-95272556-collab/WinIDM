<Window x:Class="WinIDM.App.Views.BrowserPasswordAuditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Password audit"
        Width="900" Height="560" MinWidth="700" MinHeight="420"
        WindowStartupLocation="CenterOwner">
    <DockPanel>
        <!-- ================= Page header ================= -->
        <Border DockPanel.Dock="Top" Height="56" Padding="20,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid Width="32" Height="32" VerticalAlignment="Center">
                    <Border CornerRadius="9" Background="{DynamicResource AccentSoftBrush}"
                            BorderBrush="{DynamicResource AccentSoftBorderBrush}" BorderThickness="1"/>
                    <TextBlock Text="&#xE72E;" FontFamily="Segoe MDL2 Assets" FontSize="16"
                               Foreground="{DynamicResource AccentBrush}"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Grid>
                <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="Password audit" Style="{StaticResource Heading}"/>
                    <TextBlock Style="{StaticResource Muted}" FontSize="12" Margin="0,1,0,0"
                               TextTrimming="CharacterEllipsis"
                               Text="Saved logins, with strength and duplicate checks done on this PC."/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ================= Footer actions ================= -->
        <Border DockPanel.Dock="Bottom" Margin="20,14,20,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" x:Name="StatusText" Style="{StaticResource Muted}" TextWrapping="Wrap"
                           VerticalAlignment="Center" Margin="0,0,16,0"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right"
                            VerticalAlignment="Center">
                    <Button Content="Delete selected" Style="{StaticResource DangerButton}" Margin="0,0,16,0"
                            Click="Remove_Click"/>
                    <Button Content="Analyze strength and duplicates" Style="{StaticResource PrimaryButton}"
                            Click="Analyze_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ================= Body ================= -->
        <Border Style="{StaticResource Card}" Margin="20,0,20,0" Padding="14">
            <DockPanel>
                <Grid DockPanel.Dock="Top" Margin="2,0,2,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="SearchBox" ToolTip="Search by site or user name"/>
                    <Button Grid.Column="1" Content="Search" Style="{StaticResource SecondaryButton}"
                            Margin="8,0,0,0" Click="Search_Click" IsDefault="True"/>
                    <Button Grid.Column="2" Content="Reload" Style="{StaticResource SecondaryButton}"
                            Margin="8,0,0,0" Click="Reload_Click"/>
                </Grid>

                <WrapPanel DockPanel.Dock="Top" Margin="2,0,2,12">
                    <Button Content="Export encrypted..." Style="{StaticResource SecondaryButton}"
                            Margin="0,0,8,6" Click="ExportEncrypted_Click"/>
                    <Button Content="Export raw CSV..." Style="{StaticResource SecondaryButton}"
                            Margin="0,0,8,6" Click="ExportRaw_Click"/>
                </WrapPanel>

                <Border Style="{StaticResource SoftCard}" Padding="6">
                    <ListView x:Name="List" SelectionMode="Single">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="Site" DisplayMemberBinding="{Binding Origin}" Width="220"/>
                                <GridViewColumn Header="User name" DisplayMemberBinding="{Binding User}" Width="160"/>
                                <GridViewColumn Header="Strength" DisplayMemberBinding="{Binding Strength}" Width="130"/>
                                <GridViewColumn Header="Duplicate" DisplayMemberBinding="{Binding Duplicate}" Width="100"/>
                                <GridViewColumn Header="Created" DisplayMemberBinding="{Binding Created}" Width="100"/>
                                <GridViewColumn Header="Modified" DisplayMemberBinding="{Binding Modified}" Width="100"/>
                            </GridView>
                        </ListView.View>
                    </ListView>
                </Border>
            </DockPanel>
        </Border>
    </DockPanel>
</Window>
