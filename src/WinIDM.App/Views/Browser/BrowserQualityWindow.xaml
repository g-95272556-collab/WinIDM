<Window x:Class="WinIDM.App.Views.BrowserQualityWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Choose quality"
        Width="720" Height="420" MinWidth="520" MinHeight="300"
        WindowStartupLocation="CenterOwner">
    <DockPanel>
        <!-- ================= Page header ================= -->
        <Border DockPanel.Dock="Top" Height="56" Padding="20,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid Width="32" Height="32" VerticalAlignment="Center">
                    <Border CornerRadius="9" Background="{DynamicResource AccentSoftBrush}"
                            BorderBrush="{DynamicResource AccentSoftBorderBrush}" BorderThickness="1"/>
                    <TextBlock Text="&#xE9E9;" FontFamily="Segoe MDL2 Assets" FontSize="16"
                               Foreground="{DynamicResource AccentBrush}"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Grid>
                <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="Choose quality" Style="{StaticResource Heading}"/>
                    <!-- Filled by the code-behind with the redacted source URL. -->
                    <TextBlock x:Name="HeaderText" Style="{StaticResource Muted}" FontSize="12" Margin="0,1,0,0"
                               TextTrimming="CharacterEllipsis"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ================= Footer actions ================= -->
        <Border DockPanel.Dock="Bottom" Margin="20,14,20,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" x:Name="StatusText" Style="{StaticResource Muted}" TextWrapping="Wrap"
                           VerticalAlignment="Center" Margin="0,0,16,0"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right"
                            VerticalAlignment="Center">
                    <Button Content="Copy link" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0"
                            Click="Copy_Click"/>
                    <Button Content="Download selected" Style="{StaticResource PrimaryButton}" Margin="0,0,8,0"
                            Click="Download_Click" IsDefault="True"/>
                    <Button Content="Close" Style="{StaticResource SecondaryButton}" Click="Close_Click"
                            IsCancel="True"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ================= Body ================= -->
        <Border Style="{StaticResource Card}" Margin="20,0,20,0" Padding="14">
            <Border Style="{StaticResource SoftCard}" Padding="6">
                <ListView x:Name="List" SelectionMode="Single">
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="Quality" DisplayMemberBinding="{Binding Quality}" Width="210"/>
                            <GridViewColumn Header="Type" DisplayMemberBinding="{Binding Kind}" Width="70"/>
                            <GridViewColumn Header="Estimated size" DisplayMemberBinding="{Binding Size}" Width="120"/>
                            <GridViewColumn Header="Link" DisplayMemberBinding="{Binding Url}" Width="160"/>
                        </GridView>
                    </ListView.View>
                </ListView>
            </Border>
        </Border>
    </DockPanel>
</Window>
