<Window x:Class="WinIDM.App.Views.BrowserReaderWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Reader mode"
        Width="760" Height="640" MinWidth="520" MinHeight="380"
        WindowStartupLocation="CenterOwner">
    <DockPanel>
        <!-- ================= Page header ================= -->
        <Border DockPanel.Dock="Top" Height="56" Padding="20,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid Width="32" Height="32" VerticalAlignment="Center">
                    <Border CornerRadius="9" Background="{DynamicResource AccentSoftBrush}"
                            BorderBrush="{DynamicResource AccentSoftBorderBrush}" BorderThickness="1"/>
                    <TextBlock Text="&#xE736;" FontFamily="Segoe MDL2 Assets" FontSize="16"
                               Foreground="{DynamicResource AccentBrush}"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Grid>
                <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="Reader mode" Style="{StaticResource Heading}"/>
                    <TextBlock Style="{StaticResource Muted}" FontSize="12" Margin="0,1,0,0"
                               TextTrimming="CharacterEllipsis"
                               Text="Article text only, read aloud locally. Nothing is sent anywhere."/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ================= Footer actions ================= -->
        <Border DockPanel.Dock="Bottom" Margin="20,14,20,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" x:Name="StatusText" Style="{StaticResource Muted}" TextWrapping="Wrap"
                           VerticalAlignment="Center" Margin="0,0,16,0"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right"
                            VerticalAlignment="Center">
                    <Button Content="Pause" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0"
                            Click="Pause_Click"/>
                    <Button Content="Resume" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0"
                            Click="Resume_Click"/>
                    <Button Content="Stop" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0"
                            Click="Stop_Click"/>
                    <Button Content="Read" Style="{StaticResource PrimaryButton}" Click="Play_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ================= Body ================= -->
        <Grid Margin="20,0,20,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Speech and typography settings -->
            <Border Grid.Row="0" Style="{StaticResource SoftCard}" Padding="14" Margin="0,0,0,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Margin="0,0,18,0">
                        <TextBlock Text="Voice:" Style="{StaticResource SectionLabel}" Margin="0,0,0,7"/>
                        <ComboBox x:Name="VoiceBox" MinWidth="160" SelectionChanged="Voice_Changed"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Margin="0,0,18,0">
                        <TextBlock Text="Speed:" Style="{StaticResource SectionLabel}" Margin="0,0,0,7"/>
                        <Slider x:Name="RateSlider" Width="120" Minimum="-10" Maximum="10" TickFrequency="1"
                                IsSnapToTickEnabled="True" ValueChanged="Rate_Changed" VerticalAlignment="Center"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Font size:" Style="{StaticResource SectionLabel}" Margin="0,0,0,7"/>
                        <Slider x:Name="FontSlider" Width="120" Minimum="12" Maximum="32" TickFrequency="1"
                                IsSnapToTickEnabled="True" ValueChanged="Font_Changed" VerticalAlignment="Center"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Article -->
            <Border Grid.Row="1" Style="{StaticResource Card}" Padding="20">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <TextBlock x:Name="TitleText" FontSize="22" FontWeight="SemiBold" TextWrapping="Wrap"
                                   Margin="0,0,0,4"/>
                        <TextBlock x:Name="BylineText" Style="{StaticResource Muted}" TextWrapping="Wrap"
                                   Margin="0,0,0,14"/>
                        <Border Style="{StaticResource Divider}" Margin="0,0,0,14"/>
                        <TextBlock x:Name="BodyText" TextWrapping="Wrap"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </DockPanel>
</Window>
