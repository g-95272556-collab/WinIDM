<Window x:Class="WinIDM.App.Views.BrowserShortcutsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Home page shortcuts"
        Width="620" Height="480" MinWidth="560" MinHeight="360"
        WindowStartupLocation="CenterOwner">
    <DockPanel>
        <!-- ================= Page header ================= -->
        <Border DockPanel.Dock="Top" Height="56" Padding="20,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid Width="32" Height="32" VerticalAlignment="Center">
                    <Border CornerRadius="9" Background="{DynamicResource AccentSoftBrush}"
                            BorderBrush="{DynamicResource AccentSoftBorderBrush}" BorderThickness="1"/>
                    <TextBlock Text="&#xE80F;" FontFamily="Segoe MDL2 Assets" FontSize="16"
                               Foreground="{DynamicResource AccentBrush}"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Grid>
                <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="Home page shortcuts" Style="{StaticResource Heading}"/>
                    <TextBlock Style="{StaticResource Muted}" FontSize="12" Margin="0,1,0,0"
                               TextTrimming="CharacterEllipsis"
                               Text="The tiles on the browser start page, in the order shown below."/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ================= Footer actions ================= -->
        <Border DockPanel.Dock="Bottom" Margin="20,14,20,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" x:Name="StatusText" Style="{StaticResource Muted}" TextWrapping="Wrap"
                           VerticalAlignment="Center" Margin="0,0,16,0"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right"
                            VerticalAlignment="Center">
                    <Button Content="Move up" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0"
                            Click="Up_Click"/>
                    <Button Content="Move down" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0"
                            Click="Down_Click"/>
                    <Button Content="Delete" Style="{StaticResource DangerButton}" Margin="0,0,8,0"
                            Click="Remove_Click"/>
                    <Button Content="Edit..." Style="{StaticResource SecondaryButton}" Margin="0,0,8,0"
                            Click="Edit_Click"/>
                    <Button Content="Add..." Style="{StaticResource PrimaryButton}" Click="Add_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ================= Body ================= -->
        <Border Style="{StaticResource Card}" Margin="20,0,20,0" Padding="14">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" x:Name="CountText" Style="{StaticResource Muted}"
                           Margin="2,0,2,10"/>
                <Border Style="{StaticResource SoftCard}" Padding="6">
                    <ListView x:Name="List" SelectionMode="Single">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="#" DisplayMemberBinding="{Binding Position}" Width="40"/>
                                <GridViewColumn Header="Title" DisplayMemberBinding="{Binding Title}" Width="180"/>
                                <GridViewColumn Header="URL" DisplayMemberBinding="{Binding Url}" Width="310"/>
                            </GridView>
                        </ListView.View>
                    </ListView>
                </Border>
            </DockPanel>
        </Border>
    </DockPanel>
</Window>
