<Window x:Class="WinIDM.App.Views.TextInfoWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="580" Height="430" MinWidth="380" MinHeight="260"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ================= Page header ================= -->
        <Grid Grid.Row="0" Margin="20,12,20,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid Width="36" Height="36" VerticalAlignment="Top">
                <Border CornerRadius="11" Background="{DynamicResource AccentSoftBrush}"
                        BorderBrush="{DynamicResource AccentSoftBorderBrush}" BorderThickness="1"/>
                <TextBlock Text="&#xE8A5;" FontFamily="Segoe MDL2 Assets" FontSize="16"
                           Foreground="{DynamicResource AccentBrush}"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Grid>
            <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                <TextBlock Style="{StaticResource Heading}" TextWrapping="Wrap"
                           Text="{Binding Title, RelativeSource={RelativeSource AncestorType=Window}}"/>
                <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,2,0,0"
                           Text="Read-only text. Use Copy to put it on the clipboard."/>
            </StackPanel>
        </Grid>

        <!-- ================= Body ================= -->
        <Border Grid.Row="1" Style="{StaticResource Card}" Margin="20,0,20,0" Padding="10">
            <TextBox x:Name="Body" IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True"
                     VerticalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="12"
                     VerticalContentAlignment="Top"
                     Background="Transparent" BorderThickness="0" Padding="2"/>
        </Border>

        <!-- ================= Footer ================= -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="20,12,20,16">
            <Button Content="Copy" Style="{StaticResource SecondaryButton}" MinWidth="88"
                    Margin="0,0,8,0" Click="Copy_Click"/>
            <Button Content="Close" IsDefault="True" IsCancel="True" Style="{StaticResource PrimaryButton}"
                    MinWidth="96" Click="Close_Click"/>
        </StackPanel>
    </Grid>
</Window>
