<Window x:Class="WinIDM.App.Views.ThemeEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:WinIDM.App.Views"
        Title="Custom theme editor"
        Width="940" Height="660" MinWidth="780" MinHeight="540"
        WindowStartupLocation="CenterOwner">
    <Window.Resources>
        <local:HexBrushConverter x:Key="HexBrush"/>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ================= Page header ================= -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="20,18,20,12">
            <Border Width="40" Height="40" CornerRadius="12" Background="{DynamicResource AccentSoftBrush}"
                    BorderBrush="{DynamicResource AccentSoftBorderBrush}" BorderThickness="1">
                <TextBlock Text="&#xE790;" FontFamily="Segoe MDL2 Assets" FontSize="18"
                           Foreground="{DynamicResource AccentBrush}"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                <TextBlock Text="Custom theme editor" Style="{StaticResource Heading}"/>
                <TextBlock Text="Edit any palette color and watch the preview update live."
                           Style="{StaticResource Muted}" Margin="0,2,0,0"/>
            </StackPanel>
        </StackPanel>

        <!-- ================= Body: color slots + live preview ================= -->
        <Grid Grid.Row="1" Margin="20,0,20,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="288"/>
            </Grid.ColumnDefinitions>

            <!-- 41 color slots -->
            <Border Grid.Column="0" Style="{StaticResource Card}" Padding="14" Margin="0,0,12,0">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="130"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,16,0">
                                <TextBlock Text="Name:" Margin="0,0,0,4"/>
                                <TextBox Text="{Binding ThemeName, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="Base:" Margin="0,0,0,4"/>
                                <ComboBox ItemsSource="{Binding BaseChoices}" SelectedItem="{Binding BaseChoice}"/>
                            </StackPanel>
                        </Grid>
                        <Border Style="{StaticResource Divider}" Margin="0,12,0,0"/>
                    </StackPanel>

                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl ItemsSource="{Binding Items}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,1">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="24"/>
                                            <ColumnDefinition Width="196"/>
                                            <ColumnDefinition Width="94"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" Width="20" Height="20" CornerRadius="5" BorderThickness="1"
                                                BorderBrush="{DynamicResource BorderBrush}"
                                                Background="{Binding Hex, Converter={StaticResource HexBrush}}"/>
                                        <TextBlock Grid.Column="1" Text="{Binding Label}" Margin="8,0"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <TextBox Grid.Column="2" Margin="0,1" Text="{Binding Hex, UpdateSourceTrigger=PropertyChanged}">
                                            <TextBox.Style>
                                                <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsValid}" Value="False">
                                                            <Setter Property="BorderBrush" Value="{DynamicResource DangerBrush}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBox.Style>
                                        </TextBox>
                                        <TextBlock Grid.Column="3" Text="{Binding Group}" Style="{StaticResource Muted}"
                                                   FontSize="11" Margin="10,0,0,0" TextTrimming="CharacterEllipsis"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <!-- Live preview using DynamicResource brushes -->
            <Border Grid.Column="1" Style="{StaticResource Card}" Padding="14">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="Preview" Style="{StaticResource Subheading}" Margin="0,0,0,10"/>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel>
                            <Border Background="{DynamicResource HeaderBackgroundBrush}" Padding="10,8"
                                    CornerRadius="8" Margin="0,0,0,8">
                                <TextBlock Text="WinIDM" Foreground="{DynamicResource HeaderTextBrush}" FontWeight="SemiBold"/>
                            </Border>
                            <Border Background="{DynamicResource ToolbarBackgroundBrush}" Padding="10,7"
                                    CornerRadius="8" Margin="0,0,0,8">
                                <TextBlock Text="Toolbar" Foreground="{DynamicResource ToolbarTextBrush}"/>
                            </Border>
                            <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="1" CornerRadius="8" Padding="10" Margin="0,0,0,8">
                                <StackPanel>
                                    <TextBlock Text="Primary text" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                    <TextBlock Text="Secondary text" Foreground="{DynamicResource TextSecondaryBrush}"
                                               Margin="0,2,0,8"/>
                                    <ProgressBar Value="60" Height="6" Margin="0,0,0,8"/>
                                    <TextBlock Text="Sample link" Foreground="{DynamicResource LinkTextBrush}" Margin="0,0,0,6"/>
                                    <TextBlock Text="Sample warning" Foreground="{DynamicResource WarningBrush}"/>
                                </StackPanel>
                            </Border>
                            <Border Background="{DynamicResource ListBackgroundBrush}"
                                    BorderBrush="{DynamicResource GridLineBrush}" BorderThickness="1"
                                    CornerRadius="8" Margin="0,0,0,8">
                                <StackPanel>
                                    <Border Background="{DynamicResource ColumnHeaderBackgroundBrush}" Padding="10,6">
                                        <TextBlock Text="File name" Foreground="{DynamicResource ColumnHeaderTextBrush}"/>
                                    </Border>
                                    <Border Background="{DynamicResource ListAltRowBrush}" Padding="10,6">
                                        <TextBlock Text="normal row" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                    </Border>
                                    <Border Background="{DynamicResource ListSelectionBrush}" Padding="10,6">
                                        <TextBlock Text="selected row" Foreground="{DynamicResource ListSelectionTextBrush}"/>
                                    </Border>
                                </StackPanel>
                            </Border>
                            <StackPanel Orientation="Horizontal">
                                <Border Background="{DynamicResource ButtonBackgroundBrush}"
                                        BorderBrush="{DynamicResource ButtonBorderBrush}" BorderThickness="1"
                                        CornerRadius="8" Padding="12,6" Margin="0,0,8,0">
                                    <TextBlock Text="Button" Foreground="{DynamicResource ButtonTextBrush}"/>
                                </Border>
                                <Border Background="{DynamicResource AccentBrush}" CornerRadius="8" Padding="12,6">
                                    <TextBlock Text="Accent" Foreground="{DynamicResource AccentTextBrush}"/>
                                </Border>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Grid>

        <!-- ================= Status line ================= -->
        <TextBlock Grid.Row="2" Text="{Binding Status}" Style="{StaticResource Muted}" TextWrapping="Wrap"
                   Margin="20,10,20,0" MinHeight="18"/>

        <!-- ================= Footer ================= -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="20,14,20,16">
            <Button Content="Import JSON..." Style="{StaticResource GhostButton}" Margin="0,0,4,0" Click="Import_Click"/>
            <Button Content="Export JSON..." Style="{StaticResource GhostButton}" Margin="0,0,4,0" Click="Export_Click"/>
            <Button Content="Reset" Style="{StaticResource GhostButton}" Command="{Binding ResetCommand}" Margin="0,0,14,0"/>
            <Button Content="Save and apply" Style="{StaticResource PrimaryButton}"
                    Command="{Binding SaveCommand}" Margin="0,0,8,0"/>
            <Button Content="Cancel" IsCancel="True" Click="Cancel_Click"/>
        </StackPanel>
    </Grid>
</Window>
