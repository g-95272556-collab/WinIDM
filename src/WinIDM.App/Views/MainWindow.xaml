<Window x:Class="WinIDM.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:WinIDM.App.ViewModels"
        xmlns:v="clr-namespace:WinIDM.App.Views"
        Title="WinIDM"
        Width="1280" Height="820" MinWidth="1180" MinHeight="620"
        WindowStartupLocation="CenterScreen"
        AllowDrop="True">
    <Window.InputBindings>
        <KeyBinding Key="N" Modifiers="Ctrl" Command="{Binding AddUrlCommand}"/>
        <KeyBinding Key="Delete" Command="{Binding RemoveSelectedCommand}"/>
    </Window.InputBindings>

    <Window.Resources>
        <Style TargetType="ProgressBar" x:Key="RowBar" BasedOn="{StaticResource RowProgress}"/>
    </Window.Resources>

    <DockPanel>
        <!-- ================= Accent hero: brand, search, primary actions ================= -->
        <Border DockPanel.Dock="Top" Background="{DynamicResource AccentBrush}" Padding="22,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Grid Width="42" Height="42">
                        <Border CornerRadius="13" Background="{DynamicResource AccentTextBrush}" Opacity="0.18"/>
                        <TextBlock Text="&#xE896;" FontFamily="Segoe MDL2 Assets" FontSize="20"
                                   Foreground="{DynamicResource AccentTextBrush}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Grid>
                    <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="WinIDM" FontSize="21" FontWeight="SemiBold"
                                   Foreground="{DynamicResource AccentTextBrush}"/>
                        <TextBlock Text="Downloads, torrents and a private browser" FontSize="11" Opacity="0.8"
                                   Foreground="{DynamicResource AccentTextBrush}" Margin="0,1,0,0"/>
                    </StackPanel>
                </StackPanel>

                <Border Grid.Column="1" MaxWidth="430" MinWidth="220" Height="36" Margin="24,0"
                        Background="{DynamicResource SurfaceBrush}" CornerRadius="18" Padding="14,0"
                        HorizontalAlignment="Stretch" VerticalAlignment="Center">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Left" Text="&#xE721;" FontFamily="Segoe MDL2 Assets" FontSize="13"
                                   Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"
                                   Margin="0,0,8,0"/>
                        <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="Search by file name or URL"
                                 Background="Transparent" BorderThickness="0" Padding="0"
                                 VerticalContentAlignment="Center" FontSize="12.5"/>
                    </DockPanel>
                </Border>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="Add URL" Style="{StaticResource HeroPrimaryButton}"
                            Command="{Binding AddUrlCommand}"/>
                    <Button Content="Start all" Style="{StaticResource HeroGhostButton}"
                            Command="{Binding StartAllCommand}"/>
                    <Button Content="Pause all" Style="{StaticResource HeroGhostButton}"
                            Command="{Binding PauseAllCommand}" Margin="0"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ================= Status bar ================= -->
        <Border DockPanel.Dock="Bottom" Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="18,8">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <TextBlock Text="{Binding NetworkText}" Style="{StaticResource Muted}" FontSize="12" Margin="18,0,0,0"/>
                    <TextBlock Text="{Binding TotalSpeedText}" FontSize="12" FontWeight="SemiBold" Margin="18,0,0,0"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                    <Ellipse Width="8" Height="8" Fill="{DynamicResource SuccessBrush}" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding StatusSummary}" Style="{StaticResource Muted}" FontSize="12" Margin="8,0,0,0"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ================= Navigation rail ================= -->
        <Border DockPanel.Dock="Left" Width="224" Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0">
            <DockPanel Margin="14,18,14,14">
                <StackPanel DockPanel.Dock="Top">
                    <TextBlock Text="WORKSPACE" Style="{StaticResource SectionLabel}" Margin="10,0,0,8"/>

                    <Button Style="{StaticResource SideNavButton}" Command="{Binding OpenSettingsCommand}"
                            AutomationProperties.Name="Settings">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets" FontSize="15" Width="22"
                                       VerticalAlignment="Center"/>
                            <TextBlock Text="Settings" FontWeight="SemiBold" Margin="6,0,0,0"/>
                        </StackPanel>
                    </Button>

                    <Button Style="{StaticResource SideNavButton}" Command="{Binding OpenBrowserCommand}"
                            AutomationProperties.Name="Browser">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE774;" FontFamily="Segoe MDL2 Assets" FontSize="15" Width="22"
                                       VerticalAlignment="Center"/>
                            <TextBlock Text="Browser" FontWeight="SemiBold" Margin="6,0,0,0"/>
                        </StackPanel>
                    </Button>

                    <Button Style="{StaticResource SideNavButton}" Command="{Binding OpenTorrentCommand}"
                            AutomationProperties.Name="Torrent">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE896;" FontFamily="Segoe MDL2 Assets" FontSize="15" Width="22"
                                       VerticalAlignment="Center"/>
                            <TextBlock Text="Torrent" FontWeight="SemiBold" Margin="6,0,0,0"/>
                        </StackPanel>
                    </Button>

                    <Button Style="{StaticResource SideNavButton}" Command="{Binding OpenBackupCommand}"
                            AutomationProperties.Name="Backup">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE74E;" FontFamily="Segoe MDL2 Assets" FontSize="15" Width="22"
                                       VerticalAlignment="Center"/>
                            <TextBlock Text="Backup" FontWeight="SemiBold" Margin="6,0,0,0"/>
                        </StackPanel>
                    </Button>

                    <Button Style="{StaticResource SideNavButton}" Command="{Binding OpenPasswordsCommand}"
                            AutomationProperties.Name="Passwords">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE72E;" FontFamily="Segoe MDL2 Assets" FontSize="15" Width="22"
                                       VerticalAlignment="Center"/>
                            <TextBlock Text="Passwords" FontWeight="SemiBold" Margin="6,0,0,0"/>
                        </StackPanel>
                    </Button>

                    <Border Style="{StaticResource Divider}" Margin="8,14"/>

                    <TextBlock Text="APPEARANCE" Style="{StaticResource SectionLabel}" Margin="10,0,0,8"/>

                    <Button Style="{StaticResource SideNavButton}" Command="{Binding OpenThemeEditorCommand}"
                            AutomationProperties.Name="Custom theme editor">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE790;" FontFamily="Segoe MDL2 Assets" FontSize="15" Width="22"
                                       VerticalAlignment="Center"/>
                            <TextBlock Text="Custom theme" FontWeight="SemiBold" Margin="6,0,0,0"/>
                        </StackPanel>
                    </Button>

                    <Button Style="{StaticResource SideNavButton}" Command="{Binding OpenAboutCommand}"
                            AutomationProperties.Name="About WinIDM">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE946;" FontFamily="Segoe MDL2 Assets" FontSize="15" Width="22"
                                       VerticalAlignment="Center"/>
                            <TextBlock Text="About WinIDM" FontWeight="SemiBold" Margin="6,0,0,0"/>
                        </StackPanel>
                    </Button>
                </StackPanel>

                <TextBlock DockPanel.Dock="Bottom" VerticalAlignment="Bottom" Style="{StaticResource Muted}"
                           FontSize="10.5" TextWrapping="Wrap" Margin="10,10,6,0"
                           Text="WinIDM stores everything locally. No account, no telemetry."/>
            </DockPanel>
        </Border>

        <!-- ================= Content ================= -->
        <Grid Margin="20,16,20,16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Dashboard cards -->
            <UniformGrid Grid.Row="0" Columns="4" Margin="0,0,0,14">
                <Border Style="{StaticResource Card}" Margin="0,0,12,0" Padding="16,13">
                    <StackPanel>
                        <TextBlock Text="ACTIVE" Style="{StaticResource StatLabel}"/>
                        <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                            <TextBlock Text="{Binding ActiveCountStat}" Style="{StaticResource StatValue}"/>
                            <TextBlock Text="running now" Style="{StaticResource Muted}" FontSize="11" Margin="8,0,0,4"
                                       VerticalAlignment="Bottom"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Margin="0,0,12,0" Padding="16,13">
                    <StackPanel>
                        <TextBlock Text="SPEED" Style="{StaticResource StatLabel}"/>
                        <TextBlock Text="{Binding SpeedValueText}" Style="{StaticResource StatValue}" Margin="0,3,0,0"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Margin="0,0,12,0" Padding="16,13">
                    <StackPanel>
                        <TextBlock Text="COMPLETED" Style="{StaticResource StatLabel}"/>
                        <TextBlock Text="{Binding CompletedCountStat}" Style="{StaticResource StatValue}" Margin="0,3,0,0"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Padding="16,13">
                    <StackPanel>
                        <TextBlock Text="TOTAL ITEMS" Style="{StaticResource StatLabel}"/>
                        <TextBlock Text="{Binding TotalCountStat}" Style="{StaticResource StatValue}" Margin="0,3,0,0"/>
                    </StackPanel>
                </Border>
            </UniformGrid>

            <!-- Status tabs -->
            <ItemsControl Grid.Row="1" ItemsSource="{Binding Tabs}" Margin="0,0,0,8">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <ToggleButton Style="{StaticResource TabToggle}"
                                      IsChecked="{Binding IsSelected, Mode=OneWay}"
                                      Command="{Binding DataContext.SelectTabCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                      CommandParameter="{Binding}">
                            <TextBlock Text="{Binding DisplayTitle, Mode=OneWay}"/>
                        </ToggleButton>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Filters, sort and bulk actions -->
            <DockPanel Grid.Row="2" Margin="0,0,0,10" LastChildFill="True">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"
                            Visibility="{Binding IsSchedulerTab, Converter={StaticResource InvBoolToVis}}">
                    <Button Content="Remove selected" Command="{Binding RemoveSelectedCommand}" Margin="0,0,8,0"/>
                    <Button Content="Remove completed" Command="{Binding RemoveFinishedCommand}" Margin="0,0,8,0"/>
                    <Menu VerticalAlignment="Center" Background="Transparent">
                        <MenuItem Header="Tools ▾" AutomationProperties.Name="Download tools">
                            <MenuItem Header="Batch download…" Command="{Binding BatchDownloadCommand}"/>
                            <MenuItem Header="Import links…" Command="{Binding ImportLinksCommand}"/>
                            <MenuItem Header="Export links…" Command="{Binding ExportLinksCommand}"/>
                            <Separator/>
                            <MenuItem Header="Remove leftover part files…" Command="{Binding RemoveLeftoverFilesCommand}"/>
                        </MenuItem>
                    </Menu>
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                    <ComboBox Width="152" ItemsSource="{Binding TimeFilterOptions}" SelectedItem="{Binding SelectedTimeFilter}"
                              ToolTip="Time filter" Margin="0,0,8,0"
                              Visibility="{Binding ShowTimeFilter, Converter={StaticResource BoolToVis}}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Label}"/>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <ComboBox Width="152" ItemsSource="{Binding FileTypeOptions}" SelectedItem="{Binding SelectedFileType}"
                              ToolTip="File type filter" Margin="0,0,8,0"
                              Visibility="{Binding ShowFileTypeFilter, Converter={StaticResource BoolToVis}}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Label}"/>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <ComboBox Width="176" ItemsSource="{Binding SortOptions}" SelectedItem="{Binding SelectedSort}"
                              ToolTip="Sort order">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Label}"/>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <TextBlock Text="Ctrl or Shift selects several rows; Delete removes the selection."
                               Style="{StaticResource Muted}" FontSize="11" Margin="14,0,0,0"
                               Visibility="{Binding IsSchedulerTab, Converter={StaticResource InvBoolToVis}}"/>
                </StackPanel>
            </DockPanel>

            <!-- Download list / scheduler -->
            <Grid Grid.Row="3">
                <Border Style="{StaticResource Card}" Padding="6"
                        Visibility="{Binding IsSchedulerTab, Converter={StaticResource InvBoolToVis}}">
                    <Grid>
                        <ListView x:Name="DownloadList"
                                  ItemsSource="{Binding RowsView}"
                                  SelectionMode="Extended"
                                  ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                  ItemContainerStyle="{StaticResource DownloadRow}"
                                  SelectionChanged="DownloadList_SelectionChanged"
                                  MouseDoubleClick="DownloadList_MouseDoubleClick"
                                  Background="Transparent" BorderThickness="0">
                            <ListView.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="Resume" Command="{Binding ResumeCommand}"
                                              CommandParameter="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                    <MenuItem Header="Pause" Command="{Binding PauseCommand}"
                                              CommandParameter="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                    <Separator/>
                                    <MenuItem Header="Open" Command="{Binding OpenFileCommand}"
                                              CommandParameter="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                    <MenuItem Header="Open folder" Command="{Binding OpenFolderCommand}"
                                              CommandParameter="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                    <MenuItem Header="Copy link" Command="{Binding CopyLinkCommand}"
                                              CommandParameter="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                    <MenuItem Header="Refresh link…" Command="{Binding RefreshLinkCommand}"
                                              CommandParameter="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                    <MenuItem Header="Re-download (from scratch)" Command="{Binding RedownloadCommand}"
                                              CommandParameter="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                    <Separator/>
                                    <MenuItem Header="Move up" Command="{Binding MoveUpCommand}"
                                              CommandParameter="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                    <MenuItem Header="Move down" Command="{Binding MoveDownCommand}"
                                              CommandParameter="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                    <Separator/>
                                    <MenuItem Header="Checksum (MD5 / SHA-256)" Command="{Binding ChecksumCommand}"
                                              CommandParameter="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                    <MenuItem Header="Properties" Command="{Binding ShowPropertiesCommand}"
                                              CommandParameter="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                    <Separator/>
                                    <MenuItem Header="Remove from list" Command="{Binding RemoveFromListCommand}"
                                              CommandParameter="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                    <MenuItem Header="Remove and delete file" Command="{Binding RemoveWithFileCommand}"
                                              CommandParameter="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                </ContextMenu>
                            </ListView.ContextMenu>
                            <ListView.View>
                                <GridView>
                                    <GridViewColumn Header="Name" Width="262">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold"
                                                               TextTrimming="CharacterEllipsis" MaxWidth="256"/>
                                                    <TextBlock Text="{Binding Url}" Style="{StaticResource Muted}" FontSize="10.5"
                                                               TextTrimming="CharacterEllipsis" MaxWidth="256"/>
                                                </StackPanel>
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                    <GridViewColumn Header="Type" Width="56" DisplayMemberBinding="{Binding KindText}"/>
                                    <GridViewColumn Header="Size" Width="124" DisplayMemberBinding="{Binding SizeText}"/>
                                    <GridViewColumn Header="Progress" Width="176">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <Grid Width="166" VerticalAlignment="Center">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto"/>
                                                        <RowDefinition Height="Auto"/>
                                                    </Grid.RowDefinitions>
                                                    <ProgressBar Grid.Column="0" Value="{Binding Progress, Mode=OneWay}" Maximum="100"
                                                                 IsIndeterminate="{Binding IsIndeterminate}" Style="{StaticResource RowBar}"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding ProgressText}" FontSize="11"
                                                               Margin="8,0,0,0" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                                    <!-- Each part in its place in the file (idm_pref_show_multi_part). -->
                                                    <v:SegmentBar Grid.Row="1" Grid.Column="0" Height="3" Margin="0,3,0,0"
                                                                  Segments="{Binding Segments}"
                                                                  TrackBrush="{DynamicResource SurfaceAltBrush}"
                                                                  FillBrush="{DynamicResource AccentBrush}"
                                                                  AutomationProperties.Name="Segment progress"/>
                                                </Grid>
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                    <GridViewColumn Header="Speed" Width="88" DisplayMemberBinding="{Binding SpeedText}"/>
                                    <GridViewColumn Header="ETA" Width="66" DisplayMemberBinding="{Binding EtaText}"/>
                                    <GridViewColumn Header="Status" Width="140">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <Border x:Name="Pill" CornerRadius="9" Padding="8,3" HorizontalAlignment="Left"
                                                        Background="{DynamicResource SurfaceAltBrush}">
                                                    <TextBlock x:Name="PillText" Text="{Binding StatusText}" FontSize="11"
                                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                                               TextTrimming="CharacterEllipsis" MaxWidth="118"/>
                                                </Border>
                                                <DataTemplate.Triggers>
                                                    <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                        <Setter TargetName="Pill" Property="Background" Value="{DynamicResource AccentSoftBrush}"/>
                                                        <Setter TargetName="PillText" Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsCompleted}" Value="True">
                                                        <Setter TargetName="Pill" Property="Background" Value="{DynamicResource SuccessSoftBrush}"/>
                                                        <Setter TargetName="PillText" Property="Foreground" Value="{DynamicResource SuccessBrush}"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsError}" Value="True">
                                                        <Setter TargetName="Pill" Property="Background" Value="{DynamicResource DangerSoftBrush}"/>
                                                        <Setter TargetName="PillText" Property="Foreground" Value="{DynamicResource DangerBrush}"/>
                                                    </DataTrigger>
                                                </DataTemplate.Triggers>
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                </GridView>
                            </ListView.View>
                        </ListView>

                        <!-- Empty state -->
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="430"
                                    IsHitTestVisible="False"
                                    Visibility="{Binding HasNoRows, Converter={StaticResource BoolToVis}}">
                            <Border Width="58" Height="58" CornerRadius="19" Background="{DynamicResource AccentSoftBrush}"
                                    HorizontalAlignment="Center">
                                <TextBlock Text="&#xE896;" FontFamily="Segoe MDL2 Assets" FontSize="24"
                                           Foreground="{DynamicResource AccentBrush}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="No downloads in this tab" FontSize="16" FontWeight="SemiBold"
                                       HorizontalAlignment="Center" Margin="0,16,0,5"/>
                            <TextBlock Style="{StaticResource Muted}" TextAlignment="Center" TextWrapping="Wrap"
                                       Text="Click Add URL, drag a link into this window, or press Ctrl+N."/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Scheduler -->
                <Border Style="{StaticResource Card}" MaxWidth="620" HorizontalAlignment="Left" VerticalAlignment="Top"
                        Visibility="{Binding IsSchedulerTab, Converter={StaticResource BoolToVis}}">
                    <StackPanel>
                        <TextBlock Text="Download scheduler" Style="{StaticResource Heading}" Margin="0,0,0,4"/>
                        <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,16"
                                   Text="Windows when downloads may run and how fast they may go."/>
                        <CheckBox Content="Enable scheduler" IsChecked="{Binding Scheduler.Enabled}" Margin="0,0,0,16"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="210"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Text="Start time (HH:mm)" Margin="0,0,0,10"/>
                            <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding Scheduler.Start}" Margin="0,0,0,10"
                                     Width="110" HorizontalAlignment="Left"/>
                            <TextBlock Grid.Row="1" Text="Stop time (HH:mm)" Margin="0,0,0,10"/>
                            <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding Scheduler.Stop}" Margin="0,0,0,10"
                                     Width="110" HorizontalAlignment="Left"/>
                            <TextBlock Grid.Row="2" Text="Repeat" Margin="0,0,0,10"/>
                            <ComboBox Grid.Row="2" Grid.Column="1" Margin="0,0,0,10" Width="190" HorizontalAlignment="Left"
                                      ItemsSource="{Binding Scheduler.DayOptions}" SelectedItem="{Binding Scheduler.Days}"/>
                            <TextBlock Grid.Row="3" Text="Speed limit (KB/s, 0 = none)" Margin="0,0,0,10"/>
                            <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding Scheduler.SpeedKbps}" Margin="0,0,0,10"
                                     Width="110" HorizontalAlignment="Left"/>
                        </Grid>
                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                            <Button Content="Save" Style="{StaticResource PrimaryButton}"
                                    Command="{Binding Scheduler.SaveCommand}"/>
                            <TextBlock Text="{Binding Scheduler.Message}" Style="{StaticResource Muted}"
                                       Margin="12,0,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </DockPanel>
</Window>

