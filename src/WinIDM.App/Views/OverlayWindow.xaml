<Window x:Class="WinIDM.App.Views.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WinIDM progress"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" ShowActivated="False" ResizeMode="NoResize"
        SizeToContent="Manual">
    <Window.Resources>
        <!-- Plain bar so the overlay colors from the settings are used as they are. -->
        <Style x:Key="OverlayBar" TargetType="ProgressBar">
            <Setter Property="Height" Value="4"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Grid>
                            <Rectangle x:Name="PART_Track" Fill="#33FFFFFF" RadiusX="2" RadiusY="2"/>
                            <Rectangle x:Name="PART_Indicator" HorizontalAlignment="Left" RadiusX="2" RadiusY="2"
                                       Fill="{TemplateBinding Foreground}"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border x:Name="Card" CornerRadius="10" Padding="12,9" MouseLeftButtonDown="Card_MouseLeftButtonDown"
            ToolTip="Double-click to open WinIDM">
        <Grid>
            <StackPanel x:Name="CombinedPanel" VerticalAlignment="Center">
                <TextBlock x:Name="SummaryText" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                <ProgressBar x:Name="SummaryBar" Style="{StaticResource OverlayBar}" Margin="0,6,0,0" Maximum="100"/>
            </StackPanel>

            <ScrollViewer x:Name="ListPanel" VerticalScrollBarVisibility="Hidden">
                <ItemsControl x:Name="Rows">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="0,0,0,7">
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Right" Text="{Binding ProgressText}" Margin="8,0,0,0"/>
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                </DockPanel>
                                <ProgressBar Style="{StaticResource OverlayBar}" Margin="0,4,0,2" Maximum="100"
                                             Value="{Binding Progress, Mode=OneWay}"
                                             Foreground="{Binding BarBrush, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                <TextBlock Opacity="0.85">
                                    <Run Text="{Binding SpeedText, Mode=OneWay}"/><Run Text="   "/><Run Text="{Binding EtaText, Mode=OneWay}"/>
                                </TextBlock>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>
    </Border>
</Window>
