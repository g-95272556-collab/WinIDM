<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Dark theme palette. Key names must match Light.xaml. The full 41-slot overlay is generated by ThemeService;
         these values are the static fallback and are enough to render before a palette is applied. -->
    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#14171C"/>
    <SolidColorBrush x:Key="SurfaceBrush" Color="#1C2026"/>
    <SolidColorBrush x:Key="SurfaceAltBrush" Color="#242931"/>
    <SolidColorBrush x:Key="InputBackgroundBrush" Color="#171B21"/>
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#EEF1F5"/>
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#9AA4B2"/>
    <SolidColorBrush x:Key="AccentBrush" Color="#5B8FF0"/>
    <SolidColorBrush x:Key="AccentTextBrush" Color="#0B1220"/>
    <SolidColorBrush x:Key="BorderBrush" Color="#2C333D"/>
    <SolidColorBrush x:Key="DangerBrush" Color="#F0655F"/>
    <SolidColorBrush x:Key="SuccessBrush" Color="#5FBF77"/>
    <SolidColorBrush x:Key="ProgressTrackBrush" Color="#2C333D"/>
    <SolidColorBrush x:Key="ProgressFillBrush" Color="#5B8FF0"/>
    <SolidColorBrush x:Key="WarningBrush" Color="#FFB74D"/>

    <!-- Derived tints (recomputed by ThemeService for custom palettes). -->
    <SolidColorBrush x:Key="AccentSoftBrush" Color="#22304A"/>
    <SolidColorBrush x:Key="AccentSoftBorderBrush" Color="#33486E"/>
    <SolidColorBrush x:Key="DangerSoftBrush" Color="#3A2A2C"/>
    <SolidColorBrush x:Key="SuccessSoftBrush" Color="#22322A"/>
    <SolidColorBrush x:Key="WarningSoftBrush" Color="#3A3226"/>
</ResourceDictionary>
