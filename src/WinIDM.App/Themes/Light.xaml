<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Light theme palette. Key names must match Dark.xaml. The full 41-slot overlay is generated by ThemeService;
         these values are the static fallback and are enough to render before a palette is applied. -->
    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#F2F4F8"/>
    <SolidColorBrush x:Key="SurfaceBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="SurfaceAltBrush" Color="#F6F8FB"/>
    <SolidColorBrush x:Key="InputBackgroundBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#10151C"/>
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#5D6776"/>
    <SolidColorBrush x:Key="AccentBrush" Color="#2F6FDE"/>
    <SolidColorBrush x:Key="AccentTextBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="BorderBrush" Color="#DCE1E9"/>
    <SolidColorBrush x:Key="DangerBrush" Color="#C6383B"/>
    <SolidColorBrush x:Key="SuccessBrush" Color="#2C7A46"/>
    <SolidColorBrush x:Key="ProgressTrackBrush" Color="#E4E9F0"/>
    <SolidColorBrush x:Key="ProgressFillBrush" Color="#2F6FDE"/>
    <SolidColorBrush x:Key="WarningBrush" Color="#B26A00"/>

    <!-- Derived tints (recomputed by ThemeService for custom palettes). -->
    <SolidColorBrush x:Key="AccentSoftBrush" Color="#E3ECFB"/>
    <SolidColorBrush x:Key="AccentSoftBorderBrush" Color="#B9CFF4"/>
    <SolidColorBrush x:Key="DangerSoftBrush" Color="#F9E6E6"/>
    <SolidColorBrush x:Key="SuccessSoftBrush" Color="#E4F1E7"/>
    <SolidColorBrush x:Key="WarningSoftBrush" Color="#F7EEDC"/>
</ResourceDictionary>
